{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexigon_agent.config.Config",
  "type": "object",
  "description": "Agent configuration.",
  "properties": {
    "hub-url": {
      "type": "string"
    },
    "token": {
      "$ref": "#/$defs/nexigon_agent.config.DeploymentToken"
    },
    "fingerprint-script": {
      "$ref": "#/$defs/nexigon_agent.config.PathBuf"
    },
    "data-path": {
      "$ref": "#/$defs/nexigon_agent.config.PathBuf"
    },
    "ssl-cert": {
      "$ref": "#/$defs/nexigon_agent.config.PathBuf"
    },
    "ssl-key": {
      "$ref": "#/$defs/nexigon_agent.config.PathBuf"
    },
    "dangerous-allow-plaintext": {
      "type": "boolean"
    },
    "dangerous-accept-invalid-certificates": {
      "type": "boolean"
    },
    "telemetry": {
      "$ref": "#/$defs/nexigon_agent.config.TelemetryConfig"
    },
    "exports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nexigon_agent.config.ExportConfig"
      }
    },
    "forwarding": {
      "$ref": "#/$defs/nexigon_agent.config.ForwardingConfig"
    },
    "multiplex": {
      "$ref": "#/$defs/nexigon_agent.config.MultiplexConfig"
    },
    "terminal": {
      "$ref": "#/$defs/nexigon_agent.config.TerminalConfig"
    },
    "commands": {
      "$ref": "#/$defs/nexigon_agent.config.CommandsConfig"
    },
    "operations": {
      "$ref": "#/$defs/nexigon_agent.config.OperationsConfig"
    },
    "local-api": {
      "$ref": "#/$defs/nexigon_agent.config.LocalApiConfig"
    },
    "provisioning": {
      "$ref": "#/$defs/nexigon_agent.config.ProvisioningConfig"
    },
    "integrations": {
      "$ref": "#/$defs/nexigon_agent.config.IntegrationsConfig"
    }
  },
  "required": [
    "fingerprint-script"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "nexigon_agent.config.CommandsConfig": {
      "type": "object",
      "description": "On-demand command configuration.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "directory": {
          "$ref": "#/$defs/nexigon_agent.config.PathBuf"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "nexigon_agent.config.DeploymentToken": {
      "type": "string",
      "description": "Deployment token."
    },
    "nexigon_agent.config.ExportConfig": {
      "description": "Service exports. Each HTTP export permits raw TCP access to its localhost port.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "http"
            },
            "name": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "maximum": 65535,
              "minimum": 0
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "protocol",
            "name",
            "port"
          ]
        }
      ]
    },
    "nexigon_agent.config.ForwardingConfig": {
      "type": "object",
      "description": "Additional TCP ports for CLI tunnels and Hub HTTP proxy access.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allow-all-ports": {
          "type": "boolean"
        },
        "allowed-tcp-ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nexigon_agent.config.TcpPort"
          }
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "nexigon_agent.config.IntegrationsConfig": {
      "type": "object",
      "description": "Integrations with update systems on the device.\n\nAt most one system update integration may be enabled.",
      "properties": {
        "rugix": {
          "$ref": "#/$defs/nexigon_agent.config.RugixIntegrationConfig"
        },
        "rauc": {
          "$ref": "#/$defs/nexigon_agent.config.RaucIntegrationConfig"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "nexigon_agent.config.LocalApiConfig": {
      "type": "object",
      "description": "Local API configuration.\n\nControls the Unix socket exposed by the agent for in-host clients\n(CLI, SDKs) to invoke hub actions over the agent's existing\nconnection without establishing a fresh one.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "socket-path": {
          "$ref": "#/$defs/nexigon_agent.config.PathBuf"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "nexigon_agent.config.MultiplexConfig": {
      "type": "object",
      "description": "Multiplex connection capacity and burst handling.",
      "properties": {
        "max-channels": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        },
        "reserved-channels": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        },
        "max-channel-requests-per-second": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "nexigon_agent.config.OperationsConfig": {
      "type": "object",
      "description": "Device-polled operation configuration.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "poll-interval-secs": {
          "type": [
            "integer",
            "string"
          ],
          "format": "uint64",
          "minimum": 0,
          "pattern": "^[0-9]+$"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "nexigon_agent.config.PathBuf": {
      "type": "string",
      "description": "Filesystem path."
    },
    "nexigon_agent.config.ProvisioningConfig": {
      "type": "object",
      "description": "Pairing-key provisioning configuration.\n\nWhen static credentials and provisioned credentials are both absent,\nthe agent can expose a minimal local HTTP endpoint to accept a one-time\npairing key and redeem it into device credentials.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "bind": {
          "type": "string"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "device-name": {
          "type": "string"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "nexigon_agent.config.RaucIntegrationConfig": {
      "type": "object",
      "description": "RAUC integration.",
      "properties": {
        "system-updates": {
          "$ref": "#/$defs/nexigon_agent.config.RaucSystemUpdatesConfig"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "nexigon_agent.config.RaucSystemUpdatesConfig": {
      "type": "object",
      "description": "System updates with RAUC.\n\nImplements the OTA update contract of Nexigon Hub: the agent converges toward\nthe desired state in `dev.nexigon.ota.config` and reports its progress in\n`dev.nexigon.ota.status`.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "check-interval-secs": {
          "type": [
            "integer",
            "string"
          ],
          "format": "uint64",
          "minimum": 0,
          "pattern": "^[0-9]+$"
        },
        "check-jitter-secs": {
          "type": [
            "integer",
            "string"
          ],
          "format": "uint64",
          "minimum": 0,
          "pattern": "^[0-9]+$"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "nexigon_agent.config.RugixIntegrationConfig": {
      "type": "object",
      "description": "Rugix integration.",
      "properties": {
        "system-updates": {
          "$ref": "#/$defs/nexigon_agent.config.RugixSystemUpdatesConfig"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "nexigon_agent.config.RugixSystemUpdatesConfig": {
      "type": "object",
      "description": "System updates with Rugix Ctrl.\n\nImplements the OTA update contract of Nexigon Hub: the agent converges toward\nthe desired state in `dev.nexigon.ota.config` and reports its progress in\n`dev.nexigon.ota.status`.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "check-interval-secs": {
          "type": [
            "integer",
            "string"
          ],
          "format": "uint64",
          "minimum": 0,
          "pattern": "^[0-9]+$"
        },
        "check-jitter-secs": {
          "type": [
            "integer",
            "string"
          ],
          "format": "uint64",
          "minimum": 0,
          "pattern": "^[0-9]+$"
        },
        "use-bundle-hash": {
          "type": "boolean"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "nexigon_agent.config.TcpPort": {
      "type": "number",
      "description": "TCP destination port (1–65535)."
    },
    "nexigon_agent.config.TelemetryConfig": {
      "type": "object",
      "description": "Telemetry configuration.\n\nControls automatic data collection the agent performs in the background.\nEach toggle is opt-out: defaults preserve historical behavior. Disabling\nthese is primarily useful for tests and tightly controlled deployments\nwhere the operator pushes the equivalent data manually via the CLI.",
      "properties": {
        "system-info": {
          "type": "boolean"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "nexigon_agent.config.TerminalConfig": {
      "type": "object",
      "description": "Remote terminal configuration.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "user": {
          "type": "string"
        },
        "shell": {
          "type": "string"
        },
        "allowed-users": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [],
      "unevaluatedProperties": false
    }
  }
}