{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexigon_agent.config.Config",
  "type": "object",
  "description": "Agent configuration.",
  "properties": {
    "hub-url": {
      "type": "string",
      "description": "URL of the Nexigon Hub server.\n\nRequired for static deployments. If omitted, the agent reads\nprovisioned credentials from `credentials.json` in `data-path`."
    },
    "token": {
      "$ref": "#/$defs/nexigon_agent.config.DeploymentToken",
      "description": "Deployment token.\n\nRequired for static deployments. If omitted, the agent reads\nprovisioned credentials from `credentials.json` in `data-path`."
    },
    "fingerprint-script": {
      "$ref": "#/$defs/nexigon_agent.config.PathBuf"
    },
    "data-path": {
      "$ref": "#/$defs/nexigon_agent.config.PathBuf",
      "description": "Persistent agent data directory.\n\nProvisioned credentials are stored as `credentials.json` below this\npath. Defaults to `/var/lib/nexigon/agent`."
    },
    "ssl-cert": {
      "$ref": "#/$defs/nexigon_agent.config.PathBuf"
    },
    "ssl-key": {
      "$ref": "#/$defs/nexigon_agent.config.PathBuf"
    },
    "dangerous-disable-tls": {
      "type": "boolean"
    },
    "telemetry": {
      "$ref": "#/$defs/nexigon_agent.config.TelemetryConfig"
    },
    "exports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nexigon_agent.config.ExportConfig"
      }
    },
    "terminal": {
      "$ref": "#/$defs/nexigon_agent.config.TerminalConfig"
    },
    "commands": {
      "$ref": "#/$defs/nexigon_agent.config.CommandsConfig"
    },
    "local-api": {
      "$ref": "#/$defs/nexigon_agent.config.LocalApiConfig"
    },
    "provisioning": {
      "$ref": "#/$defs/nexigon_agent.config.ProvisioningConfig"
    }
  },
  "required": [
    "fingerprint-script"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "nexigon_agent.config.CommandsConfig": {
      "$id": "nexigon_agent.config.CommandsConfig",
      "type": "object",
      "description": "On-demand command configuration.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "directory": {
          "$ref": "#/$defs/nexigon_agent.config.PathBuf"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "nexigon_agent.config.DeploymentToken": {
      "$id": "nexigon_agent.config.DeploymentToken",
      "type": [
        "string"
      ],
      "description": "Deployment token."
    },
    "nexigon_agent.config.ExportConfig": {
      "$id": "nexigon_agent.config.ExportConfig",
      "description": "Service export configuration.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "http"
            },
            "name": {
              "type": "string"
            },
            "port": {},
            "path": {
              "type": "string"
            }
          },
          "required": [
            "protocol",
            "name",
            "port"
          ]
        }
      ]
    },
    "nexigon_agent.config.LocalApiConfig": {
      "$id": "nexigon_agent.config.LocalApiConfig",
      "type": "object",
      "description": "Local API configuration.\n\nControls the Unix socket exposed by the agent for in-host clients\n(CLI, SDKs) to invoke hub actions over the agent's existing\nconnection without establishing a fresh one.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "socket-path": {
          "$ref": "#/$defs/nexigon_agent.config.PathBuf"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "nexigon_agent.config.PathBuf": {
      "$id": "nexigon_agent.config.PathBuf",
      "type": [
        "string"
      ],
      "description": "Filesystem path."
    },
    "nexigon_agent.config.ProvisioningConfig": {
      "$id": "nexigon_agent.config.ProvisioningConfig",
      "type": "object",
      "description": "Pairing-key provisioning configuration.\n\nWhen static credentials and provisioned credentials are both absent,\nthe agent can expose a minimal local HTTP endpoint to accept a one-time\npairing key and redeem it into device credentials.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether pairing-key provisioning is enabled (defaults to false)."
        },
        "bind": {
          "type": "string",
          "description": "Local bind address for the provisioning endpoint\n(defaults to `0.0.0.0:51337`)."
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Hub endpoints to try when redeeming a pairing key.\n\nDefaults to `https://eu.nexigon.cloud` and `https://us.nexigon.cloud`."
        },
        "device-name": {
          "type": "string",
          "description": "Optional display name for the device created during pairing."
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "nexigon_agent.config.TelemetryConfig": {
      "$id": "nexigon_agent.config.TelemetryConfig",
      "type": "object",
      "description": "Telemetry configuration.\n\nControls automatic data collection the agent performs in the background.\nEach toggle is opt-out: defaults preserve historical behavior. Disabling\nthese is primarily useful for tests and tightly controlled deployments\nwhere the operator pushes the equivalent data manually via the CLI.",
      "properties": {
        "system-info": {
          "type": "boolean"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "nexigon_agent.config.TerminalConfig": {
      "$id": "nexigon_agent.config.TerminalConfig",
      "type": "object",
      "description": "Remote terminal configuration.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "user": {
          "type": "string"
        },
        "shell": {
          "type": "string"
        },
        "allowed-users": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [],
      "unevaluatedProperties": false
    }
  }
}
