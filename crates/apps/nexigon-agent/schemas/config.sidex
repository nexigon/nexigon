/// Deployment token.
#[rust(type = "nexigon_ids::ids::DeploymentToken")]
#[json(type = "string")]
opaque DeploymentToken

/// Filesystem path.
#[rust(type = "std::path::PathBuf")]
#[json(type = "string")]
opaque PathBuf

/// Agent configuration.
#[json(rename_all = "kebab-case")]
record Config {
    /// URL of the Nexigon Hub server.
    ///
    /// Required for static deployments. If omitted, the agent reads
    /// provisioned credentials from `credentials.json` in `data-path`.
    hub_url?: string,
    /// Deployment token.
    ///
    /// Required for static deployments. If omitted, the agent reads
    /// provisioned credentials from `credentials.json` in `data-path`.
    token?: DeploymentToken,
    /// Fingerprint script.
    fingerprint_script: PathBuf,
    /// Persistent agent data directory.
    ///
    /// Provisioned credentials are stored as `credentials.json` below this
    /// path. Defaults to `/var/lib/nexigon/agent`.
    data_path?: PathBuf,
    /// Path to the device certificate.
    ssl_cert?: PathBuf,
    /// Path to the device private key.
    ssl_key?: PathBuf,
    /// Allow credentials to be sent over plaintext HTTP/WebSocket.
    ///
    /// This is intended only for explicitly trusted development networks.
    dangerous_allow_plaintext?: bool,
    /// Accept invalid TLS server certificates while retaining encryption.
    ///
    /// This disables peer authentication and is intended only for development.
    dangerous_accept_invalid_certificates?: bool,
    /// Telemetry configuration.
    telemetry?: TelemetryConfig,
    /// Exported services. Each HTTP export authorizes TCP forwarding to its port.
    exports?: [ExportConfig],
    /// Additional TCP ports, beyond exported services. Disabled unless explicitly enabled.
    forwarding?: ForwardingConfig,
    /// Multiplex connection capacity and burst handling.
    multiplex?: MultiplexConfig,
    /// Remote terminal configuration.
    terminal?: TerminalConfig,
    /// On-demand command configuration.
    commands?: CommandsConfig,
    /// Device-polled operation configuration.
    operations?: OperationsConfig,
    /// Local API configuration.
    local_api?: LocalApiConfig,
    /// Pairing-key provisioning configuration.
    provisioning?: ProvisioningConfig,
}

/// Pairing-key provisioning configuration.
///
/// When static credentials and provisioned credentials are both absent,
/// the agent can expose a minimal local HTTP endpoint to accept a one-time
/// pairing key and redeem it into device credentials.
#[json(rename_all = "kebab-case")]
record ProvisioningConfig {
    /// Whether pairing-key provisioning is enabled (defaults to false).
    enabled?: bool,
    /// Local bind address for the provisioning endpoint
    /// (defaults to `0.0.0.0:6947`).
    bind?: string,
    /// Hub endpoints to try when redeeming a pairing key.
    ///
    /// Defaults to `https://eu.nexigon.cloud` and `https://us.nexigon.cloud`.
    endpoints?: [string],
    /// Optional display name for the device created during pairing.
    device_name?: string,
}

/// Local API configuration.
///
/// Controls the Unix socket exposed by the agent for in-host clients
/// (CLI, SDKs) to invoke hub actions over the agent's existing
/// connection without establishing a fresh one.
#[json(rename_all = "kebab-case")]
record LocalApiConfig {
    /// Whether the local API is enabled (defaults to true).
    enabled?: bool,
    /// Path to the Unix socket
    /// (defaults to `/run/nexigon/agent/control/socket.sock`).
    socket_path?: PathBuf,
}

/// Telemetry configuration.
///
/// Controls automatic data collection the agent performs in the background.
/// Each toggle is opt-out: defaults preserve historical behavior. Disabling
/// these is primarily useful for tests and tightly controlled deployments
/// where the operator pushes the equivalent data manually via the CLI.
#[json(rename_all = "kebab-case")]
record TelemetryConfig {
    /// Whether to periodically publish `dev.nexigon.system.info` (defaults to true).
    system_info?: bool,
}

/// TCP destination port (1–65535).
#[rust(type = "std::num::NonZeroU16")]
#[json(type = "number")]
#[validate(
    { 1 <= _ <= 65535 },
    message = "TCP ports must be between 1 and 65535."
)]
opaque TcpPort

/// Additional TCP ports for CLI tunnels and Hub HTTP proxy access.
#[json(rename_all = "kebab-case")]
record ForwardingConfig {
    /// Whether the additional port allowlist is enabled (defaults to false).
    ///
    /// HTTP export ports remain accessible regardless of this setting.
    enabled?: bool,
    /// Permitted TCP destination ports on 127.0.0.1 (defaults to none).
    ///
    /// Each port permits raw TCP access. HTTP export ports are allowed separately.
    allowed_tcp_ports?: [TcpPort],
}

/// Multiplex connection capacity and burst handling.
#[json(rename_all = "kebab-case")]
record MultiplexConfig {
    /// Maximum simultaneously open channels (defaults to 512).
    #[validate(
        { 32 <= _ <= 4096 },
        message = "Maximum channels must be between 32 and 4096."
    )]
    max_channels?: u32,
    /// Channels excluded from advertised forwarding capacity, leaving room for
    /// RPC, commands, terminals, and control work (defaults to 32).
    #[validate(
        { 1 <= _ <= 4095 },
        message = "Reserved channels must be between 1 and 4095."
    )]
    reserved_channels?: u32,
    /// Maximum channel-open requests accepted per second (defaults to 2048).
    #[validate(
        { 32 <= _ <= 65536 },
        message = "Channel requests per second must be between 32 and 65536."
    )]
    max_channel_requests_per_second?: u32,
}

/// Service exports. Each HTTP export permits raw TCP access to its localhost port.
#[json(tag = "protocol", rename_all = "lowercase")]
variant ExportConfig {
    /// HTTP export configuration.
    Http: HttpExportConfig,
}

/// HTTP export configuration.
#[json(rename_all = "kebab-case")]
record HttpExportConfig {
    /// Name of the export.
    name: string,
    /// Localhost port the service listens on; also authorizes raw TCP forwarding.
    port: u16,
    /// URL path prefix for the service. Does not restrict TCP forwarding.
    path?: string,
}

/// Remote terminal configuration.
#[json(rename_all = "kebab-case")]
record TerminalConfig {
    /// Whether terminal access is enabled (defaults to false).
    enabled?: bool,
    /// Unix user for terminal sessions (defaults to `root`).
    ///
    /// Enabling terminal access without setting this field preserves the legacy
    /// root-session behavior. Set it explicitly to run sessions as another user.
    user?: string,
    /// Default shell to use (fallback: user's login shell, then /bin/sh).
    shell?: string,
    /// Allowed users for terminal sessions. If not set, only the default user is permitted.
    allowed_users?: [string],
}

/// On-demand command configuration.
#[json(rename_all = "kebab-case")]
record CommandsConfig {
    /// Whether on-demand commands are enabled (defaults to false).
    enabled?: bool,
    /// Directory containing command definition files (defaults to /etc/nexigon/agent/commands).
    directory?: PathBuf,
}

/// Device-polled operation configuration.
#[json(rename_all = "kebab-case")]
record OperationsConfig {
    /// Whether operation polling is enabled (defaults to false).
    ///
    /// Agents must explicitly opt in with `enabled = true` before they claim
    /// operation work from the hub.
    enabled?: bool,
    /// How long to wait between polls when there is no work (defaults to 60).
    ///
    /// This is an *idle* interval. Whenever a poll returns work, the agent carries it
    /// out and polls again straight away, so a multi-step operation runs at the speed of
    /// the steps rather than of this interval. What the interval bounds is how soon a
    /// device notices work that appeared while it was idle.
    ///
    /// Every device polls on this interval whether or not there is anything for it, so
    /// the cost falls on the hub and grows with the size of the fleet. Shorten it only
    /// if you need idle devices to react faster and you know the fleet is small.
    poll_interval_secs?: u64,
}

/// Command definition file.
record CommandDefinition {
    /// Command metadata.
    command: CommandMeta,
    /// JSON Schema for the command input.
    input?: CommandSchemaBlock,
    /// JSON Schema for the command output.
    output?: CommandSchemaBlock,
    /// Execution configuration.
    exec: CommandExec,
}

/// Command metadata.
record CommandMeta {
    /// Command name.
    name: string,
    /// Description of what the command does.
    description?: string,
    /// Category for grouping in the UI.
    category?: string,
}

/// JSON Schema block.
record CommandSchemaBlock {
    /// JSON Schema as a string.
    schema: string,
}

/// Command execution configuration.
record CommandExec {
    /// Executable followed by its arguments.
    ///
    /// An absolute executable path is used directly. A bare name is resolved through
    /// the agent's `PATH`; a relative path containing a directory separator is resolved
    /// from the commands directory.
    handler: [string],
    /// Timeout in seconds (defaults to 30).
    timeout?: u64,
}
