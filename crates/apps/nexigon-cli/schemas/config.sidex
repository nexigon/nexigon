/// User token or organization API token used to authenticate the CLI.
#[rust(type = "crate::config::AuthenticationToken")]
#[json(type = "string")]
opaque AuthenticationToken

/// Filesystem path.
#[rust(type = "std::path::PathBuf")]
#[json(type = "string")]
opaque PathBuf

/// CLI configuration.
#[json(rename_all = "kebab-case")]
record Config {
    /// URL of the Nexigon Hub server.
    hub_url: string,
    /// User token or organization API token.
    token: AuthenticationToken,
}
