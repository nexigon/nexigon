//! Types related to device properties.

import datetime::Timestamp
import json::JsonValue
import repositories::PackageVersionId

/// System information.
record SystemInfo {
    /// System name.
    name?: string,
    /// System version.
    version?: string,
    /// Kernel version.
    kernel?: string,
    /// Hostname.
    hostname?: string,
    /// Architecture.
    arch?: string,
    /// Memory information.
    memory: MemoryInfo,
    /// Network information.
    networks: [NetworkInterfaceInfo],
    /// Disk information.
    disks: [DiskInfo],
    /// Exported services.
    exports?: [ExportInfo],
    /// Rugix-specific system information.
    rugix?: RugixSystemInfo,
    /// Yocto-specific system information.
    yocto?: YoctoSystemInfo,
    /// Agent information.
    agent?: AgentInfo,
}

/// Memory information.
record MemoryInfo {
    /// Total memory in bytes.
    total: u64,
}

/// Network interface information.
record NetworkInterfaceInfo {
    /// Name of the network interface.
    name: string,
    /// MAC address of the network interface.
    mac_address: string,
    /// IP addresses of the network interface.
    ip_addresses: [string],
}

/// Disk information.
record DiskInfo {
    /// Name of the disk.
    name: string,
    /// Filesystem type.
    filesystem: string,
    /// Mount point.
    mount_point: string,
    /// Total disk space in bytes.
    total_space: u64,
    /// Available disk space in bytes.
    available_space: u64,
}

/// OTA update configuration (`dev.nexigon.ota.config`).
///
/// Desired state of a device. Integrations apply the property to defaults
/// built into the image as a JSON merge patch (RFC 7396): objects merge
/// recursively, `null` removes a default, and any other value, including an
/// array, replaces the default.
#[unstable(feature = "ota_updates")]
record OtaUpdateConfig {
    /// Version path in the format `<repository>/<package>/<version>`.
    ///
    /// `<version>` is a tag or a version ID. A tag tracks the version the tag
    /// points to. A version ID pins a single version.
    path?: string,
    /// Filename of the asset that the device installs from a version.
    ///
    /// Defaults to `<system>.<extension>`, where `<system>` is the name of the
    /// running system and the update system determines the extension, such as
    /// `rugixb` for Rugix Ctrl and `raucb` for RAUC.
    asset?: string,
    /// Hold the device at its current version.
    ///
    /// While set, the device starts no new update. An update in progress
    /// completes, including its activation. Defaults to false.
    hold?: bool,
    /// Maintenance window restricting when updates are activated.
    ///
    /// Updates can be activated at any time when absent.
    window?: OtaUpdateWindow,
    /// Retry policy for failed update attempts.
    retry?: OtaUpdateRetryPolicy,
    /// Spreading of updates across devices.
    ///
    /// Devices update without waiting when absent.
    spread?: OtaUpdateSpread,
    /// Rollout number.
    ///
    /// Integrations ignore its value. Changing it changes the configuration,
    /// which starts a new round of attempts on devices whose attempts failed.
    rollout?: u32,
}

/// Maintenance window in the device's local time.
///
/// The window restricts activation, the step that interrupts the device's
/// operation, such as the reboot into the new version. Integrations may
/// download and install an update outside the window if doing so does not
/// interrupt operation.
#[unstable(feature = "ota_updates")]
record OtaUpdateWindow {
    /// Time ranges in which updates can be activated.
    ///
    /// An empty list never allows activation.
    ranges: [OtaUpdateWindowRange],
}

/// Recurring time range of a maintenance window.
#[unstable(feature = "ota_updates")]
record OtaUpdateWindowRange {
    /// Days on which the range starts.
    ///
    /// Defaults to every day.
    days?: [Weekday],
    /// Start of the range (inclusive).
    start: TimeOfDay,
    /// End of the range (exclusive).
    ///
    /// An end at or before the start lies on the following day. A range whose
    /// end equals its start therefore spans 24 hours.
    end: TimeOfDay,
}

/// Time of day in the format `HH:MM` (24-hour clock).
#[validate(
    { matches(_, "^([01][0-9]|2[0-3]):[0-5][0-9]$") },
    message = "Time must have the format HH:MM (24-hour clock)."
)]
#[unstable(feature = "ota_updates")]
wrapper TimeOfDay: string

/// Day of the week.
#[json(tagged = externally, rename_all = "lowercase")]
#[unstable(feature = "ota_updates")]
variant Weekday {
    Monday,
    Tuesday,
    Wednesday,
    Thursday,
    Friday,
    Saturday,
    Sunday,
}

/// Spreading of updates across devices.
///
/// Each device derives its position `u` from the SHA-256 hash of
/// `<device-id>/<target-version-id>`: the first 8 bytes, read as a big-endian
/// unsigned integer `n`, give `u = floor(n / 2^11) / 2^53`, which a
/// double-precision number represents exactly. A device may start updating to the
/// target once both of the following hold:
///
/// - With `duration_secs`, its turn has begun at
///   `start + floor(duration_secs * sqrt(u))`. The share of eligible devices
///   thus grows quadratically from 0 at the start to 1 after `duration_secs`.
/// - With `percentage`, its position is below `percentage / 100`.
#[unstable(feature = "ota_updates")]
record OtaUpdateSpread {
    /// Time over which updates are spread, in seconds.
    duration_secs?: u32,
    /// Start of the spread over time.
    ///
    /// Defaults to the time at which the tag in the configured path was assigned
    /// to its current version. Without an explicit start, updates to versions
    /// configured by version ID are not spread over time.
    start_at?: Timestamp,
    /// Share of devices that may update, in percent.
    ///
    /// Raising the percentage only adds devices. Without `duration_secs`, it
    /// releases the update to the given share right away. With `duration_secs`,
    /// it caps the share of the spread over time.
    #[validate(
        { 0 <= _ <= 100 },
        message = "Percentage must be between 0 and 100."
    )]
    percentage?: f64,
}

/// Retry policy for failed update attempts.
///
/// An attempt starts when the device begins downloading a version. Failures
/// before that, such as an unreachable Nexigon Hub, do not count as attempts.
/// The delay between attempts starts at `initial_delay_secs` and doubles after
/// each failed attempt, up to `max_delay_secs`.
#[unstable(feature = "ota_updates")]
record OtaUpdateRetryPolicy {
    /// Maximum number of failed attempts for a version.
    ///
    /// Unlimited when absent.
    #[validate({ 1 <= _ }, message = "Maximum attempts must be at least 1.")]
    max_attempts?: u32,
    /// Delay before the first retry in seconds.
    initial_delay_secs?: u32,
    /// Maximum delay between attempts in seconds.
    max_delay_secs?: u32,
    /// Time in seconds after reaching `max_attempts` before the failure count
    /// resets and a new round of attempts begins.
    ///
    /// Without a cooldown, the device stops attempting the version until the
    /// version of the configuration changes or the failure count is cleared.
    cooldown_secs?: u32,
}

/// OTA update status (`dev.nexigon.ota.status`).
///
/// Actual state of a device, published by its update integration.
///
/// The integration writes the status with the version it read last
/// (compare-and-swap), so that it does not overwrite concurrent changes. Other
/// writers may only clear `failure_count` and `next_attempt_at`, which requests
/// a new attempt.
#[unstable(feature = "ota_updates")]
record OtaUpdateStatus {
    /// Optional features of the OTA update contract that the integration supports.
    capabilities?: [OtaUpdateCapability],
    /// Effective configuration, including the defaults the integration applies.
    config?: OtaUpdateConfig,
    /// Version of the `dev.nexigon.ota.config` property that the integration
    /// last read.
    ///
    /// Absent when the property does not exist. The version changes with every
    /// write to the device's own value and whenever a profile revision that
    /// sets the property is applied to the device, even with an unchanged
    /// value.
    config_version?: u64,
    /// Version string of the running system, as built into the image.
    ///
    /// By convention, a locked tag of the corresponding package version.
    current_version?: string,
    /// Package version of the running system.
    ///
    /// Resolved by looking up `current_version` as a tag in the configured package.
    /// Absent when the tag does not resolve.
    current_version_id?: PackageVersionId,
    /// Current state of the update process.
    state?: OtaUpdateState,
    /// Why the update is blocked. Present when `state` is `blocked`.
    blocked?: OtaUpdateBlocked,
    /// Version string of the target version, as built into its image.
    target_version?: string,
    /// Package version that the configured path resolves to.
    target_version_id?: PackageVersionId,
    /// Package version that the device installs next.
    ///
    /// Differs from `target_version_id` when the device must install a
    /// checkpoint before the target.
    next_version_id?: PackageVersionId,
    /// Number of consecutive failed attempts for the next version.
    ///
    /// Resets to zero when the next version or `config_version` changes, when
    /// the retry cooldown ends, when an update succeeds, or when another writer
    /// clears it.
    failure_count?: u32,
    /// Error message of the last failure, if any.
    last_error?: string,
    /// Earliest time of the next attempt.
    ///
    /// Set while the device waits for a spread, a maintenance window, a retry
    /// delay, or a retry cooldown. Absent when the time of the next attempt is
    /// unknown or no further attempt is scheduled.
    next_attempt_at?: Timestamp,
    /// Update system that installs versions on the device.
    updater?: OtaUpdater,
}

/// Update system that installs versions on a device, such as Rugix Ctrl or RAUC.
///
/// Slot names, states, and health values are those of the update system.
#[unstable(feature = "ota_updates")]
record OtaUpdater {
    /// Name of the update system, such as `rugix` or `rauc`.
    name: string,
    /// Version of the update system.
    version?: string,
    /// Slot that the running system booted from.
    booted_slot?: string,
    /// Slot that the device boots from next.
    ///
    /// Differs from `booted_slot` when the device runs a version on trial or
    /// has installed a version that it has not booted yet.
    primary_slot?: string,
    /// Whether the running system awaits its commit.
    awaiting_commit?: bool,
    /// Slots that the update system installs versions into.
    slots?: [OtaUpdaterSlot],
}

/// Slot of an update system.
#[unstable(feature = "ota_updates")]
record OtaUpdaterSlot {
    /// Name of the slot.
    name: string,
    /// State of the slot, such as `booted` or `inactive`.
    state?: string,
    /// Health of the slot, such as `good` or `bad`.
    health?: string,
    /// Version installed in the slot, if the update system records it.
    version?: string,
}

/// Optional feature of the OTA update contract.
#[json(tagged = externally, rename_all = "camelCase")]
#[unstable(feature = "ota_updates")]
variant OtaUpdateCapability {
    /// The integration honors `config.window`.
    Window,
    /// The integration honors `config.retry` and resets the failure count when
    /// the configuration is written.
    Retry,
    /// The integration installs checkpoints according to base versions.
    Checkpoints,
    /// The integration honors `config.spread`.
    Spread,
    /// The integration honors `config.hold`.
    Hold,
    /// The integration honors `config.asset`.
    Asset,
}

/// OTA update state.
///
/// The resting states are `idle`, `completed`, `failed`, and `blocked`.
/// The integration remains in one of these until the next check begins or
/// the blocking condition clears.
#[unstable(feature = "ota_updates")]
#[json(tagged = externally, rename_all = "lowercase")]
variant OtaUpdateState {
    /// No path is configured, or no update has been attempted yet.
    Idle,
    /// An update is being installed.
    Installing,
    /// The device is rebooting into the new version.
    Rebooting,
    /// Committing the new version after a successful reboot.
    Committing,
    /// The last update completed successfully, or the device already runs the
    /// target.
    Completed,
    /// The last update failed.
    Failed,
    /// An update is available but cannot proceed yet. See `blocked` for the reason.
    Blocked,
    /// The device is rolling back to the previous version.
    Rollback,
}

/// Information about a blocked update.
#[unstable(feature = "ota_updates")]
record OtaUpdateBlocked {
    /// Machine-readable reason in kebab case.
    ///
    /// Nexigon defines these codes:
    ///
    /// - `hold`: The configuration holds the device at its current version.
    /// - `spread`: The device waits for its turn in a spread or is outside the
    ///   released percentage.
    /// - `window`: The device waits for its maintenance window.
    /// - `no-update-path`: The target is unreachable without going back across
    ///   a checkpoint.
    /// - `unknown-current-version`: The target has a base version, but
    ///   `current_version` does not resolve to a package version.
    /// - `no-asset`: The next version has no available asset with the filename
    ///   in `config.asset`.
    ///
    /// Integrations may define their own codes for conditions specific to the
    /// device, such as `awaiting-approval`.
    #[validate(
        { matches(_, "^[a-z0-9]+(-[a-z0-9]+)*$") },
        message = "Code must be in kebab case."
    )]
    code: string,
    /// Human-readable explanation.
    message?: string,
}

/// App update configuration (`dev.nexigon.apps.config`).
///
/// Desired state of the apps on a device. The integration manages the apps listed
/// in `apps` and leaves other installed apps untouched. Removing an app from
/// `apps` ends its management without uninstalling it. To uninstall an app, set
/// its `state` to `removed`.
///
/// The policies `hold`, `window`, `retry`, `spread`, and `gc` apply to every app
/// that does not set its own. They govern version changes. Changes of an app's
/// `state` apply at the next check.
#[unstable(feature = "app_updates")]
record AppUpdateConfig {
    /// Managed apps by name.
    apps?: [string: ManagedAppConfig],
    /// Hold all apps at their current versions.
    ///
    /// While set, the device neither installs nor activates new versions. An
    /// update in progress completes. Defaults to false.
    hold?: bool,
    /// Maintenance window restricting when updates are activated.
    ///
    /// Outside the window, the device may download and install a new version of a
    /// running app without activating it. Updates can be activated at any time
    /// when absent.
    window?: OtaUpdateWindow,
    /// Retry policy for failed update attempts.
    retry?: OtaUpdateRetryPolicy,
    /// Spreading of updates across devices.
    ///
    /// Devices update without waiting when absent.
    spread?: OtaUpdateSpread,
    /// Removal of old versions after an update.
    gc?: AppGcPolicy,
}

/// Desired state of a managed app.
///
/// A policy set here replaces the policy of the configuration for this app.
#[unstable(feature = "app_updates")]
record ManagedAppConfig {
    /// Version path in the format `<repository>/<package>/<version>`.
    ///
    /// `<version>` is a tag or a version ID. A tag tracks the version the tag
    /// points to. A version ID pins a single version. Without a path, the
    /// integration does not install or update the app and only applies `state`
    /// to an installed app.
    path?: string,
    /// Filename of the bundle that the device installs from a version.
    ///
    /// `{arch}` stands for the architecture of the device. Defaults to
    /// `<app>-{arch}.rugixb`, or to `<app>.rugixb` if the version has no bundle
    /// for the architecture.
    asset?: string,
    /// Desired state of the app. Defaults to `running`.
    state?: AppDesiredState,
    /// Hold the app at its current version.
    hold?: bool,
    /// Maintenance window restricting when updates of the app are activated.
    window?: OtaUpdateWindow,
    /// Retry policy for failed update attempts of the app.
    retry?: OtaUpdateRetryPolicy,
    /// Spreading of updates of the app across devices.
    spread?: OtaUpdateSpread,
    /// Removal of old versions of the app after an update.
    gc?: AppGcPolicy,
    /// Rollout number.
    ///
    /// Integrations ignore its value. Changing it changes the app's
    /// configuration, which starts a new round of attempts on devices whose
    /// attempts failed.
    rollout?: u32,
}

/// Removal of old versions of an app.
///
/// After switching an app to a new version, the integration removes old versions
/// to free storage. It keeps the running version and the most recent previously
/// running versions, to which the app can switch back without downloading them
/// again.
#[unstable(feature = "app_updates")]
record AppGcPolicy {
    /// Number of previously running versions to keep.
    ///
    /// Defaults to the integration's default, usually 1.
    keep?: u32,
}

/// Desired state of a managed app.
#[json(tagged = externally, rename_all = "lowercase")]
#[unstable(feature = "app_updates")]
variant AppDesiredState {
    /// The app is installed and its workload runs.
    Running,
    /// The app is installed but deactivated, so that its workload does not run,
    /// also not after a reboot.
    Stopped,
    /// The app is uninstalled, including its persistent data.
    Removed,
}

/// App update status (`dev.nexigon.apps.status`).
///
/// Actual state of the apps on a device, published by its app integration.
///
/// The integration writes the status with the version it read last
/// (compare-and-swap), so that it does not overwrite concurrent changes. Other
/// writers may only clear the `failure_count` and `next_attempt_at` of an app,
/// which requests a new attempt.
#[unstable(feature = "app_updates")]
record AppUpdateStatus {
    /// Optional features of the app update contract that the integration supports.
    capabilities?: [AppUpdateCapability],
    /// Version of the `dev.nexigon.apps.config` property that the integration
    /// last read.
    ///
    /// Absent when the property does not exist. The version changes with every
    /// write to the device's own value and whenever a profile revision that
    /// sets the property is applied to the device, even with an unchanged value.
    config_version?: u64,
    /// Why the integration cannot apply the configuration, if it cannot.
    last_error?: string,
    /// Architecture of the device, which selects the bundles it installs.
    arch?: string,
    /// Runtime that installs and runs apps on the device.
    runtime?: AppRuntime,
    /// Managed and installed apps by name.
    apps: [string: AppStatus],
}

/// Runtime that installs and runs apps on a device, such as Rugix Apps.
#[unstable(feature = "app_updates")]
record AppRuntime {
    /// Name of the runtime, such as `rugix`.
    name: string,
    /// Version of the runtime.
    version?: string,
}

/// Status of an app on a device.
#[unstable(feature = "app_updates")]
record AppStatus {
    /// Whether `dev.nexigon.apps.config` lists the app.
    managed: bool,
    /// Effective configuration of the app, including the policies that apply
    /// to it.
    config?: ManagedAppConfig,
    /// Current state of the app's update process.
    state?: AppUpdateState,
    /// Why the update is blocked. Present when `state` is `blocked`.
    blocked?: AppUpdateBlocked,
    /// Generation of the app that runs, or that runs when the app starts.
    generation?: u64,
    /// Package version of `generation`.
    ///
    /// Absent when the integration did not install the generation.
    current_version_id?: PackageVersionId,
    /// Package version that the configured path resolves to.
    target_version_id?: PackageVersionId,
    /// Filename of the bundle selected from the target version.
    asset?: string,
    /// Number of consecutive failed attempts for the target version.
    ///
    /// Resets to zero when the target version or the effective configuration of
    /// the app changes, when the retry cooldown ends, when an update succeeds, or
    /// when another writer clears it.
    failure_count?: u32,
    /// Error message of the last failure, if any.
    last_error?: string,
    /// Earliest time of the next attempt.
    ///
    /// Set while the app waits for a spread, a maintenance window, a retry
    /// delay, or a retry cooldown.
    next_attempt_at?: Timestamp,
    /// Live status of the app's workload, as reported by the runtime.
    workload?: AppWorkloadStatus,
}

/// Optional feature of the app update contract.
#[json(tagged = externally, rename_all = "camelCase")]
#[unstable(feature = "app_updates")]
variant AppUpdateCapability {
    /// The integration honors `window`.
    Window,
    /// The integration honors `retry` and resets the failure count of an app
    /// when its configuration changes.
    Retry,
    /// The integration honors `spread`.
    Spread,
    /// The integration honors `hold`.
    Hold,
    /// The integration honors `asset`.
    Asset,
    /// The integration honors `gc`.
    Gc,
}

/// State of an app's update process.
///
/// The resting states are `idle`, `completed`, `failed`, and `blocked`.
#[json(tagged = externally, rename_all = "lowercase")]
#[unstable(feature = "app_updates")]
variant AppUpdateState {
    /// No path is configured.
    Idle,
    /// A new version is being downloaded and installed without interrupting
    /// the app.
    Installing,
    /// The app is switching to the installed version.
    Activating,
    /// The app is being uninstalled.
    Removing,
    /// The app has the target version and its desired state, or it has been
    /// uninstalled as desired.
    Completed,
    /// The last attempt failed.
    Failed,
    /// An update is available but cannot proceed yet. See `blocked` for the
    /// reason.
    Blocked,
}

/// Information about a blocked app update.
#[unstable(feature = "app_updates")]
record AppUpdateBlocked {
    /// Machine-readable reason in kebab case.
    ///
    /// Nexigon defines these codes:
    ///
    /// - `hold`: The configuration holds the app at its current version.
    /// - `spread`: The device waits for its turn in a spread or is outside the
    ///   released percentage.
    /// - `window`: The device waits for its maintenance window. The new version
    ///   may already be installed.
    /// - `no-asset`: The target version has no bundle for the device's
    ///   architecture or no available asset with the filename in `config.asset`.
    #[validate(
        { matches(_, "^[a-z0-9]+(-[a-z0-9]+)*$") },
        message = "Code must be in kebab case."
    )]
    code: string,
    /// Human-readable explanation.
    message?: string,
}

/// Live status of an app's workload.
#[json(tag = "state", rename_all = "lowercase")]
#[unstable(feature = "app_updates")]
variant AppWorkloadStatus {
    /// The workload runs.
    Running,
    /// The workload runs but reports a problem.
    Unhealthy: AppWorkloadMessage,
    /// The workload does not run.
    Stopped,
    /// The workload failed.
    Failed: AppWorkloadMessage,
    /// The runtime cannot determine the workload's status.
    Unknown,
}

/// Explanation of an app's workload status.
#[unstable(feature = "app_updates")]
record AppWorkloadMessage {
    /// Human-readable explanation.
    message: string,
}

/// Device health information (`dev.nexigon.system.health`).
record DeviceHealth {
    /// Health status of the device.
    status: DeviceHealthStatus,
}

/// Device health status.
#[json(tagged = externally, rename_all = "lowercase")]
variant DeviceHealthStatus {
    /// Device is operating normally.
    Healthy,
    /// Device is experiencing degraded performance.
    Degraded,
    /// Device is in an error state.
    Error,
}

/// Service export information.
#[json(tag = "protocol", rename_all = "lowercase")]
variant ExportInfo {
    /// HTTP export information.
    Http: HttpExportInfo,
}

/// HTTP export information.
record HttpExportInfo {
    /// Name of the export.
    name: string,
    /// Port the service listens on.
    port: u16,
    /// URL path prefix.
    path?: string,
}

/// Rugix-specific system information.
record RugixSystemInfo {
    /// Information about the update slots.
    slots: [string: RugixSlotInfo],
    /// Rugix-specific boot information.
    boot?: RugixBootInfo,
    /// Information about the state management mechanism.
    state: RugixStateManagementInfo,
    /// Rugix Bakery build information (only when built with Rugix Bakery).
    build?: RugixBakeryBuildInfo,
}

/// Information about a Rugix update slot.
record RugixSlotInfo {
    /// Indicates whether the slot is active, i.e., in use.
    active?: bool,
    /// Hashes of the slot data according to the slot database.
    hashes?: [string: string],
    /// Size of the slot data according to the slot database.
    size?: u64,
    /// Last time the slot has been updated according to the slot database.
    updated_at?: string,
}

/// Rugix-specific boot information.
record RugixBootInfo {
    /// Name of the boot flow.
    boot_flow: string,
    /// Active boot group.
    active_group?: string,
    /// Default boot group.
    default_group?: string,
    /// Information about the boot groups.
    groups: [string: RugixBootGroupInfo],
}

/// Information about a Rugix boot group.
record RugixBootGroupInfo {}

/// Information about Rugix's state management mechanism.
#[json(tag = "status")]
variant RugixStateManagementInfo {
    /// State management is disabled.
    Disabled,
    /// State management is active.
    Active: RugixActiveStateManagementInfo,
    /// State management is inactive due to an error.
    ///
    /// State is stored in memory and will fail to persist even if declared.
    Error,
}

/// Information about the state management mechanism, if state management is active.
record RugixActiveStateManagementInfo {
    /// Device backing the data partition, if any.
    data_partition?: string,
}

/// Rugix Bakery build information.
record RugixBakeryBuildInfo {
    /// System name.
    name: string,
    /// Rugix Bakery build release information.
    release: RugixBakeryReleaseInfo,
}

/// Rugix Bakery build release information.
record RugixBakeryReleaseInfo {
    /// Release ID.
    id: string,
    /// Release version.
    version: string,
}

/// Yocto-specific system information.
record YoctoSystemInfo {
    /// Build information key-value pairs read from `/etc/buildinfo`.
    build_info: [string: string],
}

/// Agent information.
record AgentInfo {
    /// Agent version.
    version: string,
    /// Agent feature configuration.
    config: AgentConfig,
}

/// Agent feature configuration.
record AgentConfig {
    /// Terminal feature configuration.
    terminal?: AgentTerminalConfig,
    /// Commands feature configuration.
    commands?: AgentCommandsConfig,
}

/// Agent terminal feature configuration.
record AgentTerminalConfig {
    /// Whether the remote terminal is enabled.
    enabled?: bool,
    /// Available terminal users.
    users?: [string],
}

/// Agent commands feature configuration.
record AgentCommandsConfig {
    /// Whether on-demand commands are enabled.
    enabled?: bool,
}

/// Command manifest (`dev.nexigon.commands` property).
#[unstable(feature = "device_commands")]
record DeviceCommandManifest {
    /// Available commands.
    commands: [DeviceCommandDescriptor],
}

/// Descriptor for an on-demand command.
#[unstable(feature = "device_commands")]
record DeviceCommandDescriptor {
    /// Command name.
    name: string,
    /// Description of what the command does.
    description?: string,
    /// Category for grouping in the UI.
    category?: string,
    /// JSON Schema for the command input.
    input?: JsonValue,
    /// JSON Schema for the command output.
    output?: JsonValue,
}
