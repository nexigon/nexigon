//! Actions and types related to repositories.

import audit::AuditLogEvent
import audit::AuditLogReferences
import datetime::Timestamp
import digest::Digest
import json::JsonValue
import organizations::OrganizationId
import outputs::Empty
import pagination::PageInfo
import pagination::PageRequest
import projects::ProjectId

/// Unique ID of a repository.
#[rust(type = "nexigon_ids::ids::RepositoryId")]
#[json(type = "string")]
opaque RepositoryId

/// Unique ID of a repository asset.
#[rust(type = "nexigon_ids::ids::RepositoryAssetId")]
#[json(type = "string")]
opaque RepositoryAssetId

/// Unique ID of a package.
#[rust(type = "nexigon_ids::ids::PackageId")]
#[json(type = "string")]
opaque PackageId

/// Unique ID of a package version.
#[rust(type = "nexigon_ids::ids::PackageVersionId")]
#[json(type = "string")]
opaque PackageVersionId

/// Asset status.
#[json(tagged = externally)]
variant RepositoryAssetStatus {
    /// The asset has been created but not yet uploaded.
    Dangling,
    /// The asset has been uploaded and is available.
    Available,
    /// The asset is in the process of being deleted.
    Deleting,
}

/// Result of the latest non-destructive object-storage check.
#[json(tagged = externally)]
variant RepositoryAssetStorageStatus {
    /// The asset has not been checked yet.
    Unknown,
    /// A legacy object exists with the expected size, but has no verifiable checksum metadata.
    Present,
    /// The object carries matching size, checksum, digest, and ownership metadata.
    Verified,
    /// No object exists at the expected key.
    Missing,
    /// The object exists but its size or verification metadata does not match.
    Mismatched,
    /// The storage provider could not be checked.
    Error,
}

/// Latest object-storage check for an asset.
record RepositoryAssetStorage {
    status: RepositoryAssetStorageStatus,
    checked_at?: Timestamp,
    detail?: string,
}

/// Repository visibility.
#[json(tagged = externally)]
variant RepositoryVisibility {
    /// The repository is public and can be accessed by anyone.
    Public,
    /// The repository is private and can only be accessed by its members.
    Private,
}

/// S3 connection settings for a repository or organization.
record RepositoryS3Config {
    /// S3 endpoint (e.g., https://s3.amazonaws.com or https://minio.local:9000).
    #[validate(
        { 1 <= _.size <= 2048 },
        message = "S3 endpoint must be between 1 and 2048 characters."
    )]
    #[validate(
        { matches(_, "^https?://") },
        message = "S3 endpoint must be an HTTP(S) URL.",
        code = "format:url"
    )]
    endpoint: string,
    /// S3 bucket name.
    #[validate(
        { 3 <= _.size <= 63 },
        message = "S3 bucket name must be between 3 and 63 characters."
    )]
    #[validate(
        { matches(_, "^[a-z0-9][a-z0-9.-]*[a-z0-9]$") },
        message = "S3 bucket name must use only lowercase letters, digits, dots, and hyphens, and start and end with a letter or digit.",
        code = "format:s3_bucket"
    )]
    bucket: string,
    /// AWS region (required by AWS, may be NULL for MinIO/other providers).
    #[validate(
        { 1 <= _.size <= 64 },
        message = "AWS region must be between 1 and 64 characters."
    )]
    region?: string,
    /// Optional bucket prefix. Organization storage adds `repositories/<repository-id>/`.
    #[validate(
        { _.size <= 1024 },
        message = "Bucket prefix must be at most 1024 characters."
    )]
    prefix?: string,
    /// Force path-style bucket addressing.
    /// By default, Nexigon uses virtual-hosted addressing.
    force_path_style?: bool,
    /// S3 access key ID (not sensitive, can be plain text).
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Access key ID must be between 1 and 256 characters."
    )]
    access_key_id: string,
    /// S3 secret access key (sensitive, will be stored encrypted).
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Secret access key must be between 1 and 256 characters."
    )]
    secret_access_key?: string,
}

/// Resolve a repository by its name.
///
/// Within an organization, the repository is given by its path name. The
/// organization defaults to that of the request, which is set by an organization
/// API token, the `X-Nexigon-Organization` header, or the project of a device.
/// Without an organization, the repository is given by its slug. A repository ID
/// resolves in both cases.
#[request(
    name = "repositories_ResolveName",
    response = ResolveRepositoryNameOutput
)]
record ResolveRepositoryNameAction {
    /// Organization to resolve path names in.
    ///
    /// Defaults to the organization of the request. See the action for details.
    organization_id?: OrganizationId,
    /// Path name, slug, or ID of the repository.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Repository name must be between 1 and 128 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Repository name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:repository_name"
    )]
    repository: string,
}

/// Output of resolving a repository by its name.
#[json(tag = "result")]
variant ResolveRepositoryNameOutput {
    /// The repository has been found.
    #[json(content = "repositoryId")]
    Found: RepositoryId,
    /// The repository has not been found.
    /// 
    /// This may also be returned if the actor does not have the necessary permissions.
    NotFound,
}

/// Get information about a repository.
#[request(
    name = "repositories_GetDetails",
    response = GetRepositoryDetailsOutput
)]
record GetRepositoryDetailsAction {
    /// ID of the repository.
    repository_id: RepositoryId,
}

/// Output of getting information about a repository.
record GetRepositoryDetailsOutput {
    /// ID of the repository.
    repository_id: RepositoryId,
    /// Display name of the repository.
    display_name: string,
    /// Path name of the repository, unique within its organization.
    ///
    /// Absent on older Hub versions.
    path_name?: string,
    /// Slug of the repository, unique on the instance, if one has been set.
    slug?: string,
    /// Public name of the repository.
    ///
    /// Falls back to the repository ID when no slug is set.
    #[deprecated(
        note = "Use `slug`, which is absent when no slug is set.",
        remove_in = "2029.2"
    )]
    public_name: string,
    /// Visibility of the repository.
    visibility: RepositoryVisibility,
    /// Number of packages in the repository.
    package_count: u64,
    /// Number of assets in the repository.
    asset_count: u64,
}

/// Create a new repository.
#[request(name = "repositories_Create", response = CreateRepositoryOutput)]
record CreateRepositoryAction {
    /// Organization to create the repository in.
    organization_id: OrganizationId,
    /// Display name of the repository.
    ///
    /// Free-form, human-facing name.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Display name must be between 1 and 128 characters."
    )]
    display_name: string,
    /// Path name of the repository, unique within the organization.
    ///
    /// Defaults to `default`, with a numeric suffix such as `default-2` if it is
    /// already taken.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Path name must be between 1 and 128 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Path name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:repository_path_name"
    )]
    path_name?: string,
    /// Visibility of the repository.
    ///
    /// Default to private.
    visibility?: RepositoryVisibility,
}

/// Output of creating a repository.
#[json(tag = "result")]
variant CreateRepositoryOutput {
    /// A repository with the same path name already exists in the organization.
    NameAlreadyExists,
    /// The repository has been created.
    Created: CreateRepositorySuccess,
}

/// Successfully created a repository.
record CreateRepositorySuccess {
    /// ID of the repository.
    repository_id: RepositoryId,
}

/// Delete a repository.
#[request(name = "repositories_Delete", response = Empty)]
record DeleteRepositoryAction {
    /// ID of the repository.
    repository_id: RepositoryId,
}

/// Set the visibility of a repository.
#[request(name = "repositories_SetVisibility", response = Empty)]
record SetRepositoryVisibilityAction {
    /// ID of the repository.
    repository_id: RepositoryId,
    /// New visibility of the repository.
    visibility: RepositoryVisibility,
}

/// Set the display name of a repository.
#[request(name = "repositories_SetDisplayName", response = Empty)]
record SetRepositoryDisplayNameAction {
    /// ID of the repository.
    repository_id: RepositoryId,
    /// New display name of the repository.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Display name must be between 1 and 128 characters."
    )]
    display_name: string,
}

/// Set the path name of a repository.
///
/// Paths that use the previous path name no longer resolve.
#[request(
    name = "repositories_SetPathName",
    response = SetRepositoryPathNameOutput
)]
record SetRepositoryPathNameAction {
    /// ID of the repository.
    repository_id: RepositoryId,
    /// New path name of the repository.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Path name must be between 1 and 128 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Path name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:repository_path_name"
    )]
    path_name: string,
}

/// Output of setting the path name of a repository.
#[json(tag = "result")]
variant SetRepositoryPathNameOutput {
    /// A repository with the same path name already exists in the organization.
    NameAlreadyExists,
    /// The path name has been set.
    Success,
}

/// Set the slug of a repository.
///
/// The slug is unique on the instance. It addresses the repository in paths
/// resolved without an organization, for example, by anonymous clients of a public
/// repository.
///
/// Note: Setting the slug requires the `public_repositories` subscription feature.
#[request(name = "repositories_SetSlug", response = SetRepositorySlugOutput)]
record SetRepositorySlugAction {
    /// ID of the repository.
    repository_id: RepositoryId,
    /// New slug of the repository.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Repository slug must be between 1 and 128 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Repository slug must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:repository_slug"
    )]
    slug: string,
}

/// Output of setting the slug of a repository.
#[json(tag = "result")]
variant SetRepositorySlugOutput {
    /// A repository with the same slug already exists.
    SlugAlreadyExists,
    /// The slug has been set.
    Success,
}

/// Query the packages of a repository.
#[request(
    name = "repositories_QueryPackages",
    response = QueryRepositoryPackagesOutput
)]
record QueryRepositoryPackagesAction {
    /// ID of the repository.
    repository_id: RepositoryId,
}

/// Output of querying the packages of a repository.
record QueryRepositoryPackagesOutput {
    /// List of packages.
    packages: [QueryRepositoryPackagesItem],
}

/// Package query item.
record QueryRepositoryPackagesItem {
    /// Human-readable name, falling back to `name` when absent.
    display_name?: string,
    /// ID of the package.
    package_id: PackageId,
    /// Name of the package.
    name: string,
    /// Kind of the package (e.g., "rugix-app").
    kind?: string,
    /// Timestamp when the package was created.
    created_at: Timestamp,
    /// CommonMark description. Absent when not set or on older Hub versions.
    description?: string,
    /// Root-relative URL for the PNG on this Hub. Absent when no image is set.
    image_url?: string,
    /// Number of versions of the package. Absent on older Hub versions.
    version_count?: u64,
    /// Most recently created version. Absent when the package has no versions
    /// or on older Hub versions.
    latest_version?: QueryPackageVersionsItem,
}

/// Query the assets of a repository.
#[request(
    name = "repositories_QueryAssets",
    response = QueryRepositoryAssetsOutput
)]
record QueryRepositoryAssetsAction {
    /// ID of the repository.
    repository_id: RepositoryId,
    /// Bounded cursor page. Omission preserves the legacy unbounded response.
    page?: PageRequest,
    /// Defaults to all assets. Totals always cover the whole repository.
    filter?: RepositoryAssetFilter,
    /// Defaults to largest first for pages, creation order for legacy requests.
    sort?: RepositoryAssetSort,
}

/// Restrict the asset inventory without changing repository totals.
#[json(tagged = externally)]
variant RepositoryAssetFilter {
    All,
    Unused,
    Issues,
}

/// Asset ordering, with a stable internal ID as the tie breaker.
#[json(tagged = externally)]
variant RepositoryAssetSort {
    Largest,
    CleanupDate,
}

/// Output of querying the assets of a repository.
record QueryRepositoryAssetsOutput {
    /// List of assets.
    assets: [QueryRepositoryAssetsItem],
    /// Repository-wide storage totals. Absent on older Hubs.
    usage?: RepositoryAssetUsage,
    /// Automatic cleanup policy. Absent on older Hubs.
    cleanup?: RepositoryAssetCleanupSettings,
    /// Continuation for a requested page. Absent for legacy requests.
    page?: PageInfo,
}

/// Automatic cleanup policy for unused repository assets.
record RepositoryAssetCleanupSettings {
    enabled: bool,
    /// Whole days without package references before automatic deletion.
    grace_days: u16,
    /// Most recent enablement. Existing unused assets receive a full grace period.
    enabled_at?: Timestamp,
}

/// Storage totals count each asset once, regardless of its reference count.
record RepositoryAssetUsage {
    asset_count: u64,
    /// Bytes of objects last observed present or verified, including pending deletions.
    stored_bytes: u64,
    /// Stored bytes with at least one package or version attachment.
    referenced_bytes: u64,
    /// Stored bytes without package or version attachments.
    unused_bytes: u64,
    /// Declared bytes whose presence is unknown, missing, or inconsistent.
    unconfirmed_bytes: u64,
    /// Number of assets with unknown, missing, inconsistent, or failed storage checks.
    unconfirmed_count: u64,
    /// Number of assets with a failed deletion attempt.
    cleanup_error_count: u64,
    /// Oldest storage observation among stored assets.
    checked_at?: Timestamp,
}

/// Retention information, independent of object-storage verification.
record RepositoryAssetLifecycle {
    reference_count: u64,
    unreferenced_since?: Timestamp,
    /// Earliest automatic deletion time; absent while cleanup is disabled or referenced.
    eligible_at?: Timestamp,
    deletion_started_at?: Timestamp,
    /// Sanitized reason for the latest cleanup failure.
    deletion_error?: string,
}

/// Configure automatic cleanup. Requires permission to manage repository settings.
#[request(name = "repositories_SetAssetCleanup", response = Empty)]
record SetRepositoryAssetCleanupAction {
    repository_id: RepositoryId,
    enabled: bool,
    #[validate({ 1 <= _ }, message = "Grace period must be at least one day.")]
    grace_days: u16,
}

/// List the package attachments retaining a repository asset.
#[request(
    name = "repositories_GetAssetReferences",
    response = GetAssetReferencesOutput
)]
record GetAssetReferencesAction {
    asset_id: RepositoryAssetId,
    /// Bounded cursor page. Omission preserves the legacy unbounded response.
    page?: PageRequest,
}

record GetAssetReferencesOutput {
    references: [RepositoryAssetReference],
    /// Package attachments precede version attachments, each in stable ID order.
    page?: PageInfo,
}

/// One retaining package or version attachment.
record RepositoryAssetReference {
    package_id: PackageId,
    package_name: string,
    /// Absent for a package-level attachment.
    version_id?: PackageVersionId,
    version_name?: string,
    filename: string,
}

/// Asset query item.
record QueryRepositoryAssetsItem {
    /// Reference count and cleanup status. Absent on older Hubs.
    lifecycle?: RepositoryAssetLifecycle,
    /// ID of the asset.
    asset_id: RepositoryAssetId,
    /// Size of the asset.
    size: u64,
    /// Digest of the asset.
    digest: Digest,
    /// Latest storage check. Absent when connected to an older Hub.
    storage?: RepositoryAssetStorage,
}

/// Query repository projects.
#[request(
    name = "repositories_QueryLinkedProjects",
    response = QueryRepositoryProjectsOutput
)]
record QueryRepositoryProjectsAction {
    /// ID of the repository.
    repository_id: RepositoryId,
}

/// Output of querying the projects of a repository.
record QueryRepositoryProjectsOutput {
    /// List of projects.
    projects: [QueryRepositoryProjectsItem],
}

/// Project item.
record QueryRepositoryProjectsItem {
    /// ID of the project.
    project_id: ProjectId,
    /// Name of the project.
    name: string,
}

/// Resolve a package by its path.
///
/// Within an organization, the repository is given by its path name. The
/// organization defaults to that of the request, which is set by an organization
/// API token, the `X-Nexigon-Organization` header, or the project of a device.
/// Without an organization, the repository is given by its slug. A repository ID
/// resolves in both cases.
#[request(
    name = "repositories_ResolvePackageByPath",
    response = ResolvePackageByPathOutput
)]
record ResolvePackageByPathAction {
    /// Organization to resolve path names in.
    ///
    /// Defaults to the organization of the request. See the action for details.
    organization_id?: OrganizationId,
    /// Path name, slug, or ID of the repository.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Repository name must be between 1 and 128 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Repository name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:repository_name"
    )]
    repository: string,
    /// Name or ID of the package.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Package name must be between 1 and 128 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Package name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:package_name"
    )]
    package: string,
}

/// Output of resolving a package by its path.
#[json(tag = "result")]
variant ResolvePackageByPathOutput {
    /// The package has been found.
    Found: ResolvePackageByPathSuccess,
    /// The package has not been found.
    NotFound,
}

/// Successfully resolved package by path.
record ResolvePackageByPathSuccess {
    /// ID of the repository.
    repository_id: RepositoryId,
    /// ID of the package.
    package_id: PackageId,
}

/// Get information about a package.
#[request(
    name = "repositories_GetPackageDetails",
    response = GetPackageDetailsOutput
)]
record GetPackageDetailsAction {
    /// ID of the package.
    package_id: PackageId,
}

/// Output of getting information about a package.
record GetPackageDetailsOutput {
    /// Optional display information. Absent on older Hub versions.
    presentation?: PackagePresentation,
    /// Image upload limits configured by this Hub. Absent on older Hub versions.
    image_limits?: PackageImageLimits,
    /// ID of the package.
    package_id: PackageId,
    /// Name of the package.
    name: string,
    /// Kind of the package (e.g., "rugix-app").
    kind?: string,
    /// Number of versions of the package.
    version_count: u64,
    /// Package retention policy. Absent on older Hub versions.
    retention?: PackageVersionRetention,
    /// Package-level metadata.
    metadata: [string: JsonValue],
    /// Assets attached to the package itself (independent of versions).
    /// Used by the package-level VEX flow but generic — anything that
    /// wants to live on the package can be attached here.
    assets: [PackageAsset],
}

/// One asset attached at the package level.
record PackageAsset {
    asset_id: RepositoryAssetId,
    filename: string,
    size: u64,
    digest: Digest,
    status: RepositoryAssetStatus,
    /// Latest storage check. Absent when connected to an older Hub.
    storage?: RepositoryAssetStorage,
    metadata: [string: JsonValue],
}

/// Attach a repository asset to a package under the given filename.
///
/// Symmetric to `AddPackageVersionAssetAction` but for the package
/// itself rather than a specific version. The asset must already exist
/// in the same repository; the link carries an arbitrary metadata
/// dictionary.
#[request(
    name = "repositories_AddPackageAsset",
    response = AddPackageAssetOutput
)]
record AddPackageAssetAction {
    package_id: PackageId,
    asset_id: RepositoryAssetId,
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Filename must be between 1 and 256 characters."
    )]
    filename: string,
    metadata?: [string: JsonValue],
}

/// Output of adding a package asset.
#[json(tag = "result")]
variant AddPackageAssetOutput {
    /// An asset with the same filename already exists on this package.
    FilenameAlreadyExists,
    /// The asset has been added.
    Added,
}

/// Remove a package asset by filename.
#[request(name = "repositories_RemovePackageAsset", response = Empty)]
record RemovePackageAssetAction {
    package_id: PackageId,
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Filename must be between 1 and 256 characters."
    )]
    filename: string,
}

/// Replace the metadata on a package asset.
#[request(name = "repositories_SetPackageAssetMetadata", response = Empty)]
record SetPackageAssetMetadataAction {
    package_id: PackageId,
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Filename must be between 1 and 256 characters."
    )]
    filename: string,
    metadata: [string: JsonValue],
}

/// Create a new package.
#[request(name = "repositories_CreatePackage", response = CreatePackageOutput)]
record CreatePackageAction {
    /// Optional initial display information.
    presentation?: PackagePresentationUpdate,
    /// ID of the repository.
    repository_id: RepositoryId,
    /// Name of the package.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Package name must be between 1 and 128 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Package name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:package_name"
    )]
    name: string,
    /// Kind of the package (e.g., "rugix-app").
    #[validate(
        { 1 <= _.size <= 64 },
        message = "Package kind must be between 1 and 64 characters."
    )]
    #[validate(
        { matches(_, "^[a-z0-9][a-z0-9._-]*$") },
        message = "Package kind must start with a lowercase letter or digit and contain only lowercase letters, digits, dots, underscores, or hyphens.",
        code = "format:package_kind"
    )]
    kind?: string,
    /// Optional initial metadata.
    metadata?: [string: JsonValue],
}

/// Display information for a package, independent of its URL-safe name.
record PackagePresentation {
    /// Human-readable name. Absent when the URL-safe package name is used.
    display_name?: string,
    /// CommonMark description. Raw HTML is not rendered by the Hub UI.
    description?: string,
    /// Root-relative URL for the PNG on this Hub. Absent when no image is set.
    /// Fetch with the same credentials as package details. Supports ETag validation.
    image_url?: string,
}

/// Replace display text and optionally change the package image.
record PackagePresentationUpdate {
    /// Human-readable name. Omit to display the URL-safe package name.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Display name must be between 1 and 128 characters."
    )]
    display_name?: string,
    /// CommonMark description. Raw HTML is not rendered by the Hub UI.
    #[validate(
        { _.size <= 65536 },
        message = "Description must be at most 65536 characters."
    )]
    description?: string,
    /// Omit to preserve the current image, or leave a new package without an image.
    image?: PackageImageUpdate,
}

/// Change the image while saving package display information.
variant PackageImageUpdate {
    /// Replace with a base64-encoded static PNG, without a data URL prefix.
    /// Defaults to at most 1 MiB and 1024 pixels per side; see `image_limits`.
    #[json(content = "imagePng")]
    Replace: string,
    /// Remove the current image.
    Remove,
}

/// Limits for a package image, applied before it is stored.
record PackageImageLimits {
    /// Maximum decoded file size in bytes.
    max_bytes: u32,
    /// Maximum width and height in pixels.
    max_dimension: u32,
}

/// Replace display text and optionally change the image.
/// Omitted display name and description are cleared; an omitted image is preserved.
#[request(name = "repositories_SetPackagePresentation", response = Empty)]
record SetPackagePresentationAction {
    package_id: PackageId,
    presentation: PackagePresentationUpdate,
}

/// Output of creating a package.
#[json(tag = "result")]
variant CreatePackageOutput {
    /// A package with the same name already exists.
    NameAlreadyExists,
    /// The package has been created.
    Created: CreatePackageSuccess,
}

/// Successfully created a package.
record CreatePackageSuccess {
    /// ID of the package.
    package_id: PackageId,
}

/// Delete a package.
#[request(name = "repositories_DeletePackage", response = Empty)]
record DeletePackageAction {
    /// ID of the package.
    package_id: PackageId,
}

/// Set metadata on a package.
#[request(name = "repositories_SetPackageMetadata", response = Empty)]
record SetPackageMetadataAction {
    /// ID of the package.
    package_id: PackageId,
    /// Metadata to set (replaces existing metadata).
    metadata: [string: JsonValue],
}

/// Set the kind of a package.
#[request(name = "repositories_SetPackageKind", response = Empty)]
record SetPackageKindAction {
    /// ID of the package.
    package_id: PackageId,
    /// New kind of the package (e.g., "rugix-app"), or null to clear.
    #[validate(
        { 1 <= _.size <= 64 },
        message = "Package kind must be between 1 and 64 characters."
    )]
    #[validate(
        { matches(_, "^[a-z0-9][a-z0-9._-]*$") },
        message = "Package kind must start with a lowercase letter or digit and contain only lowercase letters, digits, dots, underscores, or hyphens.",
        code = "format:package_kind"
    )]
    kind?: string,
}

/// Set the name of a package.
#[request(name = "repositories_SetPackageName", response = SetPackageNameOutput)]
record SetPackageNameAction {
    /// ID of the package.
    package_id: PackageId,
    /// New name of the package.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Package name must be between 1 and 128 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Package name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:package_name"
    )]
    name: string,
}

/// Output of setting the name of a package.
#[json(tag = "result")]
variant SetPackageNameOutput {
    /// A package with the same name already exists.
    NameAlreadyExists,
    /// The name has been set.
    Success,
}

/// Query a page of the versions of a package, newest first.
#[request(
    name = "repositories_QueryPackageVersions",
    response = QueryPackageVersionsOutput
)]
record QueryPackageVersionsAction {
    /// ID of the package.
    package_id: PackageId,
    /// Only return versions matching this filter.
    filter?: PackageVersionFilter,
    /// Page to return. Without this field, the first page is returned.
    page?: PageRequest,
}

/// Conditions on package versions.
record PackageVersionFilter {
    /// Case-insensitive substring of the version's name, ID, or one of its tags.
    search?: string,
}

/// Output of querying the versions of a package.
record QueryPackageVersionsOutput {
    /// Versions on this page.
    versions: [QueryPackageVersionsItem],
    /// Continuation of the traversal.
    page: PageInfo,
}

/// Package version query item.
record QueryPackageVersionsItem {
    /// ID of the package version.
    version_id: PackageVersionId,
    /// Optional name of the version.
    name?: string,
    /// Timestamp when the package version was created.
    created_at: Timestamp,
    /// Explicit deletion deadline. Package retention can delete the version earlier.
    delete_at?: Timestamp,
    /// Sealed versions reject content changes and all deletion. Absent on older Hub versions.
    sealed?: bool,
    /// Tags of the package version.
    tags: [PackageVersionTag],
    /// Version that a device must run before installing this version.
    base_version_id?: PackageVersionId,
    /// Optional name of the base version.
    base_version_name?: string,
    /// Number of assets of the version. Absent on older Hub versions.
    asset_count?: u64,
    /// Total size of the version's assets in bytes. Absent on older Hub versions.
    asset_size?: u64,
}

/// Query a page of the tags of a package, most recently assigned first.
#[request(
    name = "repositories_QueryPackageTags",
    response = QueryPackageTagsOutput
)]
record QueryPackageTagsAction {
    /// ID of the package.
    package_id: PackageId,
    /// Only return tags matching this filter.
    filter?: PackageTagFilter,
    /// Page to return. Without this field, the first page is returned.
    page?: PageRequest,
}

/// Conditions on package tags.
record PackageTagFilter {
    /// Case-insensitive substring of the tag.
    search?: string,
}

/// Output of querying the tags of a package.
record QueryPackageTagsOutput {
    /// Tags on this page.
    tags: [QueryPackageTagsItem],
    /// Continuation of the traversal.
    page: PageInfo,
}

/// Tag of a package and the version it points to.
record QueryPackageTagsItem {
    /// Tag.
    tag: string,
    /// Indicates whether the tag is locked.
    locked: bool,
    /// Time at which the tag was assigned to its version.
    assigned_at: Timestamp,
    /// ID of the version the tag points to.
    version_id: PackageVersionId,
    /// Optional name of the version the tag points to.
    version_name?: string,
}

/// Package version tag.
record PackageVersionTag {
    /// Tag of the package version.
    tag: string,
    /// Indicates whether the tag is locked.
    locked: bool,
    /// Time at which the tag was assigned to the version. Absent on older Hub versions.
    assigned_at?: Timestamp,
}

/// Add tag item.
record AddTagItem {
    /// Tag to add.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Tag must be between 1 and 128 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._+-]*$") },
        message = "Tag must start with a letter or digit and contain only letters, digits, dots, plus signs, underscores, or hyphens.",
        code = "format:tag"
    )]
    tag: string,
    /// Indicates whether the tag should be locked.
    ///
    /// Defaults to false.
    locked?: bool,
    /// Indicates whether the tag should be reassigned, if it already exists.
    ///
    /// Defaults to false. Adding a tag that is assigned to another version fails
    /// unless the tag is reassigned. Locked tags are never reassigned.
    reassign?: bool,
}

/// Remove tag item.
record RemoveTagItem {
    /// Tag to remove.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Tag must be between 1 and 128 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._+-]*$") },
        message = "Tag must start with a letter or digit and contain only letters, digits, dots, plus signs, underscores, or hyphens.",
        code = "format:tag"
    )]
    tag: string,
}

/// Package version asset.
record PackageVersionAsset {
    /// Filename of the asset.
    filename: string,
    /// ID of the asset.
    asset_id: RepositoryAssetId,
    /// Size of the asset.
    size: u64,
    /// Digest of the asset.
    digest: Digest,
    /// Status of the asset.
    status: RepositoryAssetStatus,
    /// Latest storage check. Absent when connected to an older Hub.
    storage?: RepositoryAssetStorage,
    /// Arbitrary metadata associated with this asset in the version.
    metadata: [string: JsonValue],
}

/// Resolve a package version by its path.
///
/// A path consists of a repository, a package, and a version tag. Devices can resolve
/// versions in repositories linked to their project.
///
/// Within an organization, the repository is given by its path name. The
/// organization defaults to that of the request, which is set by an organization
/// API token, the `X-Nexigon-Organization` header, or the project of a device.
/// Without an organization, the repository is given by its slug. A repository ID
/// resolves in both cases.
#[group(name = "device")]
#[request(
    name = "repositories_ResolveVersionByPath",
    response = ResolvePackageVersionByPathOutput
)]
record ResolvePackageVersionByPathAction {
    /// Organization to resolve path names in.
    ///
    /// Defaults to the organization of the request. See the action for details.
    organization_id?: OrganizationId,
    /// Path name, slug, or ID of the repository.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Repository name must be between 1 and 128 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Repository name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:repository_name"
    )]
    repository: string,
    /// Name or ID of the package.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Package name must be between 1 and 128 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Package name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:package_name"
    )]
    package: string,
    /// Tag or ID of the version.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Tag must be between 1 and 128 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._+-]*$") },
        message = "Tag must start with a letter or digit and contain only letters, digits, dots, plus signs, underscores, or hyphens.",
        code = "format:tag"
    )]
    tag: string,
}

/// Output of resolving a package version by its path.
#[json(tag = "result")]
variant ResolvePackageVersionByPathOutput {
    /// The package version has been found.
    Found: ResolvePackageVersionByPathSuccess,
    /// The package version has not been found.
    NotFound,
}

/// Successfully resolved package version by path.
record ResolvePackageVersionByPathSuccess {
    /// ID of the repository.
    repository_id: RepositoryId,
    /// ID of the package.
    package_id: PackageId,
    /// ID of the package version.
    version_id: PackageVersionId,
}

/// Get information about a package version.
#[group(name = "device")]
#[request(
    name = "repositories_GetVersionDetails",
    response = GetPackageVersionDetailsOutput
)]
record GetPackageVersionDetailsAction {
    /// ID of the package version.
    version_id: PackageVersionId,
}

/// Output of getting information about a package version.
record GetPackageVersionDetailsOutput {
    /// ID of the package version.
    version_id: PackageVersionId,
    /// ID of the repository.
    repository_id: RepositoryId,
    /// ID of the package.
    package_id: PackageId,
    /// Optional name of the version.
    name?: string,
    /// Assets of the version.
    assets: [PackageVersionAsset],
    /// Tags of the version.
    tags: [PackageVersionTag],
    /// Version-level metadata.
    metadata: [string: JsonValue],
    /// Explicit deletion deadline. Package retention can delete the version earlier.
    delete_at?: Timestamp,
    /// Sealed versions reject content changes and all deletion. Absent on older Hub versions.
    sealed?: bool,
    /// Version that a device must run before installing this version.
    base_version_id?: PackageVersionId,
    /// Timestamp when the package version was created. Absent on older Hub versions.
    created_at?: Timestamp,
    /// Optional name of the base version.
    base_version_name?: string,
}

/// Create a new package version.
#[request(
    name = "repositories_CreateVersion",
    response = CreatePackageVersionOutput
)]
record CreatePackageVersionAction {
    /// ID of the package.
    package_id: PackageId,
    /// Optional name of the version.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Version name must be between 1 and 128 characters."
    )]
    name?: string,
    /// Earliest automatic deletion time; must be in the future. Package retention applies independently.
    /// Removes the version and all tags. Unused assets follow repository cleanup policy.
    delete_at?: Timestamp,
    /// Tags to add to the package version.
    tags?: [AddTagItem],
    /// Optional initial metadata.
    metadata?: [string: JsonValue],
    /// Version that a device must run before installing this version.
    ///
    /// Must belong to the same package and must not be scheduled for deletion.
    base_version_id?: PackageVersionId,
}

/// Output of creating a package version.
#[json(tag = "result")]
variant CreatePackageVersionOutput {
    /// The package version has been created.
    Created: CreatePackageVersionSuccess,
}

/// Package version creation has been successful.
record CreatePackageVersionSuccess {
    /// ID of the package version.
    version_id: PackageVersionId,
}

/// Delete a package version.
///
/// A version that is the base of another version cannot be deleted.
#[request(name = "repositories_DeleteVersion", response = Empty)]
record DeletePackageVersionAction {
    /// ID of the package version.
    version_id: PackageVersionId,
}

/// Schedule or cancel automatic deletion. Requires permission to manage versions.
/// Deletion removes the version and all tags, including locked tags. It does not
/// check device installations. Unused assets follow the repository cleanup policy.
/// A version that is the base of another version cannot be scheduled.
#[request(name = "repositories_SetVersionDeletionSchedule", response = Empty)]
record SetPackageVersionDeletionScheduleAction {
    version_id: PackageVersionId,
    /// Future deadline. Null or omission cancels this schedule; package retention still applies.
    /// A deadline makes deletion eligible; background processing may delay it.
    delete_at?: Timestamp,
}

/// Set the name of a package version.
#[request(name = "repositories_SetVersionName", response = Empty)]
record SetPackageVersionNameAction {
    /// ID of the package version.
    version_id: PackageVersionId,
    /// New name of the package version.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Version name must be between 1 and 128 characters."
    )]
    name?: string,
}

/// Set or clear the base of a package version. Requires permission to manage versions.
///
/// The base must belong to the same package, must not be scheduled for deletion, and
/// must not lead back to the version through its own bases. Sealed versions reject
/// changes to their base.
#[request(name = "repositories_SetVersionBase", response = Empty)]
record SetPackageVersionBaseAction {
    /// ID of the package version.
    version_id: PackageVersionId,
    /// New base version. Omit to clear the base.
    base_version_id?: PackageVersionId,
}

/// Set metadata on a package version.
#[request(name = "repositories_SetVersionMetadata", response = Empty)]
record SetPackageVersionMetadataAction {
    /// ID of the package version.
    version_id: PackageVersionId,
    /// Metadata to set (replaces existing metadata).
    metadata: [string: JsonValue],
}

/// Add an asset to a package version.
#[request(
    name = "repositories_AddVersionAsset",
    response = AddPackageVersionAssetOutput
)]
record AddPackageVersionAssetAction {
    /// ID of the package version.
    version_id: PackageVersionId,
    /// ID of the asset.
    asset_id: RepositoryAssetId,
    /// Filename of the asset.
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Filename must be between 1 and 256 characters."
    )]
    filename: string,
    /// Optional metadata to associate with this asset in the version.
    metadata?: [string: JsonValue],
}

/// Output of adding an asset to a package version.
#[json(tag = "result")]
variant AddPackageVersionAssetOutput {
    /// An asset with the same filename already exists.
    FilenameAlreadyExists,
    /// The asset has been added to the package version.
    Added,
}

/// Remove an asset from a package version.
#[request(name = "repositories_RemoveVersionAsset", response = Empty)]
record RemovePackageVersionAssetAction {
    /// ID of the package version.
    version_id: PackageVersionId,
    /// Filename of the asset.
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Filename must be between 1 and 256 characters."
    )]
    filename: string,
}

/// Set metadata on a package version asset.
#[request(name = "repositories_SetVersionAssetMetadata", response = Empty)]
record SetPackageVersionAssetMetadataAction {
    /// ID of the package version.
    version_id: PackageVersionId,
    /// Filename of the asset.
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Filename must be between 1 and 256 characters."
    )]
    filename: string,
    /// Metadata to set (replaces existing metadata).
    metadata: [string: JsonValue],
}

/// Add tags to a version.
#[request(name = "repositories_TagVersion", response = Empty)]
record TagPackageVersionAction {
    /// ID of the package version.
    version_id: PackageVersionId,
    /// Tags to add.
    tags: [AddTagItem],
}

/// Remove tags from a version.
#[request(name = "repositories_UntagVersion", response = Empty)]
record UntagPackageVersionAction {
    /// ID of the package version.
    version_id: PackageVersionId,
    /// Tags to remove.
    tags: [RemoveTagItem],
}

/// Resolve a version asset by its path.
///
/// A path consists of a repository, a package, a version tag, and the asset's
/// filename within the version.
///
/// Within an organization, the repository is given by its path name. The
/// organization defaults to that of the request, which is set by an organization
/// API token, the `X-Nexigon-Organization` header, or the project of a device.
/// Without an organization, the repository is given by its slug. A repository ID
/// resolves in both cases.
#[group(name = "device")]
#[request(
    name = "repositories_ResolveVersionAssetByPath",
    response = ResolvePackageVersionAssetByPathOutput
)]
record ResolvePackageVersionAssetByPathAction {
    /// Organization to resolve path names in.
    ///
    /// Defaults to the organization of the request. See the action for details.
    organization_id?: OrganizationId,
    /// Path name, slug, or ID of the repository.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Repository name must be between 1 and 128 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Repository name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:repository_name"
    )]
    repository: string,
    /// Name or ID of the package.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Package name must be between 1 and 128 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Package name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:package_name"
    )]
    package: string,
    /// Tag or ID of the version.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Tag must be between 1 and 128 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._+-]*$") },
        message = "Tag must start with a letter or digit and contain only letters, digits, dots, plus signs, underscores, or hyphens.",
        code = "format:tag"
    )]
    tag: string,
    /// Filename or ID of the asset.
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Filename must be between 1 and 256 characters."
    )]
    filename: string,
}

/// Output of resolving a version asset by its path.
#[json(tag = "result")]
variant ResolvePackageVersionAssetByPathOutput {
    /// The asset has been found.
    Found: ResolvePackageVersionAssetByPathSuccess,
    /// The asset has not been found.
    NotFound,
}

/// Successfully resolved version asset by path.
record ResolvePackageVersionAssetByPathSuccess {
    /// ID of the repository.
    repository_id: RepositoryId,
    /// ID of the package.
    package_id: PackageId,
    /// ID of the package version.
    version_id: PackageVersionId,
    /// ID of the asset.
    asset_id: RepositoryAssetId,
}

/// Set the S3 configuration for the repository.
#[request(name = "repositories_SetS3Config", response = Empty)]
record SetRepositoryS3ConfigAction {
    /// ID of the repository.
    repository_id: RepositoryId,
    /// S3 config for the repository.
    s3_config: RepositoryS3Config,
}

/// Get the S3 configuration for the repository.
#[request(
    name = "repositories_GetS3Config",
    response = GetRepositoryS3ConfigOutput
)]
record GetRepositoryS3ConfigAction {
    /// ID of the repository.
    repository_id: RepositoryId,
}

/// Output of getting the S3 configuration for the repository.
/// 
/// This intentionally does not include the secret access key.
record GetRepositoryS3ConfigOutput {
    /// Effective storage source. Inherited credentials are not exposed here.
    source: RepositoryStorageSource,
    /// S3 config for the repository.
    s3_config: RepositoryS3Config,
}

/// Get information about an asset.
#[request(
    name = "repositories_GetAssetDetails",
    response = GetAssetDetailsOutput
)]
record GetAssetDetailsAction {
    /// ID of the asset.
    asset_id: RepositoryAssetId,
}

/// Output of getting information about an asset.
record GetAssetDetailsOutput {
    /// ID of the asset.
    asset_id: RepositoryAssetId,
    /// Size of the asset.
    size: u64,
    /// Digest of the asset.
    digest: Digest,
    /// Status of the asset.
    status: RepositoryAssetStatus,
    /// Latest storage check. Absent when connected to an older Hub.
    storage?: RepositoryAssetStorage,
    /// Number of package and package-version attachments that retain the asset.
    reference_count: u64,
}

/// Create an asset.
#[request(name = "repositories_CreateAsset", response = CreateAssetOutput)]
record CreateAssetAction {
    /// ID of the repository.
    repository_id: RepositoryId,
    /// Size of the asset.
    size: u64,
    /// Digest of the asset.
    digest: Digest,
}

/// Output of creating an asset.
#[json(tag = "result")]
variant CreateAssetOutput {
    /// An asset with the same digest already exists.
    #[json(content = "assetId")]
    AssetAlreadyExists: RepositoryAssetId,
    /// The asset has been created.
    #[json(content = "assetId")]
    Created: RepositoryAssetId,
}

/// Schedule deletion of an unused asset. Referenced assets are rejected.
/// The asset remains visible until object-storage deletion completes.
#[request(name = "repositories_DeleteAsset", response = Empty)]
record DeleteAssetAction {
    /// ID of the asset.
    asset_id: RepositoryAssetId,
}

/// Issue a URL for downloading an asset.
///
/// The URL is valid for two hours and requires no further authentication.
#[group(name = "device")]
#[request(
    name = "repositories_IssueAssetDownloadUrl",
    response = IssueAssetDownloadUrlOutput
)]
record IssueAssetDownloadUrlAction {
    /// ID of the asset to issue the URL for.
    asset_id: RepositoryAssetId,
    /// Filename under which browsers save the download, set through the
    /// `Content-Disposition` header of the download response.
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Filename must be between 1 and 256 characters."
    )]
    filename?: string,
}

/// Output of issuing a URL for downloading an asset.
record IssueAssetDownloadUrlOutput {
    /// URL for downloading the asset.
    url: string,
}

/// Issue a URL for uploading an asset.
#[request(
    name = "repositories_IssueAssetUploadUrl",
    response = IssueAssetUploadUrlOutput
)]
record IssueAssetUploadUrlAction {
    /// ID of the asset to issue the URL for.
    asset_id: RepositoryAssetId,
}

/// Output of issuing a URL for uploading an asset.
record IssueAssetUploadUrlOutput {
    /// Compatibility URL for uploading the asset without verification headers.
    ///
    /// Objects uploaded through this URL remain dangling. New clients should use
    /// `verified_url`, apply every entry in `headers`, and finalize the upload.
    url: string,
    /// URL for an upload whose digest and ownership Nexigon Hub can verify.
    verified_url?: string,
    /// Headers that must accompany a request to `verified_url`.
    headers?: [string: string],
}

/// Verify an uploaded object and make its asset available.
///
/// This action is idempotent: finalizing an already available asset succeeds.
#[request(name = "repositories_FinalizeAssetUpload", response = Empty)]
record FinalizeAssetUploadAction {
    /// ID of the pending asset to finalize.
    asset_id: RepositoryAssetId,
}

/// Query the audit log of the repository.
#[request(
    name = "repositories_QueryAuditLog",
    response = QueryAuditLogEventsOutput
)]
record QueryAuditLogEventsAction {
    /// Opt into cursor pagination. Without this field, the existing limit applies.
    page?: PageRequest,
    /// ID of the repository.
    repository_id: RepositoryId,
}

/// Output of querying the audit log of the repository.
record QueryAuditLogEventsOutput {
    /// Present when cursor pagination was requested.
    page?: PageInfo,
    /// List of audit log events.
    events: [AuditLogEvent],
    /// Names of the actors of the returned events.
    ///
    /// Absent in responses of Nexigon Hub 2026.3 and earlier.
    references?: AuditLogReferences,
}

/// The scope supplying repository storage.
#[json(tagged = externally)]
variant RepositoryStorageSource {
    Unconfigured,
    Repository,
    Organization,
}

/// Remove a repository override and use organization storage when configured.
#[request(name = "repositories_DeleteS3Config", response = Empty)]
record DeleteRepositoryS3ConfigAction {
    repository_id: RepositoryId,
}

/// Opt-in retention of unsealed versions, evaluated per package by creation time.
/// Either exceeded limit makes a version eligible for deletion, including existing versions.
/// Retention skips versions that are the base of another version.
record PackageVersionRetention {
    enabled: bool,
    /// Maximum number of newest unsealed versions to keep. Sealed versions do not count.
    #[validate(
        { 1 <= _ <= 2147483647 },
        message = "Version count must be a positive integer."
    )]
    max_versions?: u32,
    /// Maximum age in fixed 24-hour days. This can expire every unsealed version.
    #[validate(
        { 1 <= _ <= 2147483647 },
        message = "Maximum age must be a positive number of days."
    )]
    max_age_days?: u32,
}

/// Replace the package retention policy. Requires permission to manage versions.
#[request(name = "repositories_SetPackageVersionRetention", response = Empty)]
record SetPackageVersionRetentionAction {
    package_id: PackageId,
    retention: PackageVersionRetention,
}

/// Permanently seal a version. Requires permission to manage versions.
/// Sealing cancels scheduled deletion and blocks changes to the name, metadata,
/// base version, and attachments, as well as deletion of the version, package,
/// or repository.
/// Tags remain editable. Sealing cannot be reversed.
#[request(name = "repositories_SealVersion", response = Empty)]
record SealPackageVersionAction {
    version_id: PackageVersionId,
}
