//! Cluster identifier types.
//!
//! Cluster bookkeeping (registration, heartbeats, sweep) is internal and
//! lives in the internal API. Only the opaque [`ClusterNodeId`] is part of
//! the public surface, because [`actor::ClusterNodeActor`] and
//! [`devices`] connection records reference it.

/// Unique ID of a cluster node.
#[rust(type = "nexigon_ids::ids::ClusterNodeId")]
#[json(type = "string")]
opaque ClusterNodeId
