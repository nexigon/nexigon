//! Actions and types related to devices.

import actor::Actor
import audit::AuditLogEvent
import cluster::ClusterNodeId
import datetime::Timestamp
import fleet::FleetOperationId
import json::JsonExpr
import json::JsonMutation
import json::JsonValue
import jwt::Jwt
import outputs::Empty
import projects::DeploymentToken
import projects::DeploymentTokenId
import projects::ProjectId
import properties::DeviceCommandManifest

/// Unique ID of a device.
#[rust(type = "nexigon_ids::ids::DeviceId")]
#[json(type = "string")]
opaque DeviceId

/// Device fingerprint.
#[rust(type = "nexigon_ids::ids::DeviceFingerprint")]
#[json(type = "string")]
opaque DeviceFingerprint

/// Device fingerprint ID.
#[rust(type = "nexigon_ids::ids::DeviceFingerprintId")]
#[json(type = "string")]
opaque DeviceFingerprintId

/// Unique ID of a device certificate.
#[rust(type = "nexigon_ids::ids::DeviceCertificateId")]
#[json(type = "string")]
opaque DeviceCertificateId

/// Unique ID of a device connection.
#[rust(type = "nexigon_ids::ids::DeviceConnectionId")]
#[json(type = "string")]
opaque DeviceConnectionId

/// Fingerprint of a device certificate.
#[rust(type = "nexigon_cert::Sha256Fingerprint")]
#[json(type = "string")]
opaque CertificateFingerprint

/// ID of a device event (unique per device).
#[rust(type = "nexigon_ids::ids::DeviceEventId")]
#[json(type = "string")]
opaque DeviceEventId

/// Query the devices of the instance.
#[request(name = "devices_Query", response = QueryDevicesOutput)]
record QueryDevicesAction {}

/// Output of querying the devices of the instance.
record QueryDevicesOutput {
    /// List of devices.
    devices: [QueryDevicesItem],
}

/// Device item.
record QueryDevicesItem {
    /// ID of the device.
    device_id: DeviceId,
    /// Project ID of the device.
    project_id: ProjectId,
    /// Indicates whether the device is currently connected.
    is_connected: bool,
    /// Timestamp when the device was last connected (current or most recent connection).
    last_connected_at?: Timestamp,
    /// Duration of the current connection in seconds (null if not connected).
    current_connection_duration_secs?: u32,
}

/// Get information about a device.
#[request(name = "devices_GetDetails", response = GetDeviceDetailsOutput)]
record GetDeviceDetailsAction {
    /// ID of the device.
    device_id: DeviceId,
}

/// Output of getting information about a device.
record GetDeviceDetailsOutput {
    /// ID of the device.
    device_id: DeviceId,
    /// Project ID of the device.
    project_id: ProjectId,
    /// Fingerprint ID the device.
    fingerprint_id: DeviceFingerprintId,
    /// Name of the device.
    name?: string,
    /// Indicates whether the device is online.
    is_connected: bool,
    /// Certificates of the device.
    certificates: [DeviceCertificate],
    /// Connections of the device.
    connections: [DeviceConnection],
}

/// Device certificate.
record DeviceCertificate {
    /// ID of the certificate.
    certificate_id: DeviceCertificateId,
    /// Status of the certificate.
    status: DeviceCertificateStatus,
    /// Fingerprint of the certificate.
    fingerprint: CertificateFingerprint,
    /// Timestamp when the certificate was first seen.
    first_seen: Timestamp,
}

/// Device connection.
record DeviceConnection {
    /// ID of the connection.
    connection_id: DeviceConnectionId,
    /// ID of the cluster node.
    node_id: ClusterNodeId,
    /// Timestamp when the connection was established.
    connected_at: Timestamp,
    /// Duration of the connection in seconds.
    connected_for_secs: u32,
}

/// Combined device status (connection + health).
#[json(tagged = externally, rename_all = "lowercase")]
variant DeviceStatus {
    /// Device is healthy and connected.
    Healthy,
    /// Device is connected but experiencing degraded performance.
    Warning,
    /// Device is connected but in an error state.
    Error,
    /// Device is not connected.
    Offline,
}

/// Status of a device certificate.
#[json(tagged = externally)]
variant DeviceCertificateStatus {
    /// The certificate is pending.
    Pending,
    /// The certificate is active.
    Active,
    /// The certificate has been rejected.
    Rejected,
    /// The certificate has been revoked.
    Revoked,
    /// The certificate fingerprint was seen on multiple devices.
    Conflict,
}

/// Reason why a device connection ended.
#[json(tagged = externally)]
variant ConnectionEndReason {
    /// Unknown reason (fallback).
    Unknown,
    /// Device disconnected normally.
    Disconnected,
    /// Connection ended due to cluster node crash or heartbeat timeout.
    NodeCrashed,
    /// Connection ended due to graceful server shutdown.
    ServerShutdown,
}

/// Device connection log entry (for connection history).
record DeviceConnectionLog {
    /// ID of the connection.
    connection_id: DeviceConnectionId,
    /// ID of the cluster node.
    node_id: ClusterNodeId,
    /// Timestamp when the connection was established.
    connected_at: Timestamp,
    /// Timestamp when the connection ended (null if still connected).
    ended_at?: Timestamp,
    /// Reason why the connection ended (null if still connected).
    end_reason?: ConnectionEndReason,
    /// Duration of the connection in seconds.
    duration_secs: u32,
}

/// Create a new device.
#[request(name = "devices_Create", response = CreateDeviceOutput)]
record CreateDeviceAction {
    /// ID of the project.
    project_id: ProjectId,
    /// Fingerprint of the device.
    fingerprint: DeviceFingerprint,
}

/// Output of creating a new device.
record CreateDeviceOutput {
    /// ID of the device.
    device_id: DeviceId,
}

/// Delete a device.
#[request(name = "devices_Delete", response = Empty)]
record DeleteDeviceAction {
    /// ID of the device.
    device_id: DeviceId,
}

/// Set the name of a device.
#[request(name = "devices_SetName", response = Empty)]
record SetDeviceNameAction {
    /// ID of the device.
    device_id: DeviceId,
    /// New name of the device.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Device name must be between 1 and 128 characters."
    )]
    name?: string,
}

/// Issue a JWT for a device with user-defined claims.
///
/// **Note: Only use this action for integration with external systems.**
#[request(name = "devices_IssueDeviceToken", response = IssueDeviceTokenOutput)]
record IssueDeviceTokenAction {
    /// ID of the device.
    device_id: DeviceId,
    /// Token validity duration in seconds.
    #[validate(
        { 1 <= _ <= 31536000 },
        message = "Token validity must be between 1 second and 1 year."
    )]
    valid_for_secs?: u32,
    /// Additional user-defined claims.
    claims?: JsonValue,
}

/// Output of issuing a JWT for a device.
record IssueDeviceTokenOutput {
    /// Issued JWT.
    jwt: Jwt,
}

/// Validate a device JWT.
/// 
/// **Note: Only use this action for integration with external systems.**
#[request(
    name = "devices_ValidateDeviceToken",
    response = ValidateDeviceTokenOutput
)]
record ValidateDeviceTokenAction {
    /// JWT to validate.
    jwt: Jwt,
}

/// Output of validating a device JWT.
#[json(tag = "result")]
variant ValidateDeviceTokenOutput {
    /// The JWT is invalid.
    Invalid,
    /// The JWT is valid.
    Valid: ValidateDeviceTokenSuccess,
}

/// Successful validation of a device JWT.
record ValidateDeviceTokenSuccess {
    /// ID of the device.
    device_id: DeviceId,
    /// User-defined claims.
    claims: JsonValue,
}

/// Add a device certificate.
#[request(name = "devices_AddCertificate", response = AddDeviceCertificateOutput)]
record AddDeviceCertificateAction {
    /// ID of the device.
    device_id: DeviceId,
    /// Fingerprint of the certificate.
    fingerprint: CertificateFingerprint,
    /// Initial status of the certificate.
    /// 
    /// Defaults to `Pending`.
    status?: DeviceCertificateStatus,
}

/// Output of adding a device certificate.
record AddDeviceCertificateOutput {
    /// ID of the certificate.
    certificate_id: DeviceCertificateId,
}

/// Delete a device certificate.
#[request(name = "devices_DeleteCertificate", response = Empty)]
record DeleteDeviceCertificateAction {
    /// ID of the certificate.
    certificate_id: DeviceCertificateId,
}

/// Set the status of a device certificate.
#[request(name = "devices_SetCertificateStatus", response = Empty)]
record SetDeviceCertificateStatusAction {
    /// ID of the certificate.
    certificate_id: DeviceCertificateId,
    /// New status of the certificate.
    status: DeviceCertificateStatus,
}

/// Register a connection of a device to a cluster node.
#[request(
    name = "devices_RegisterConnection",
    response = RegisterDeviceConnectionOutput
)]
record RegisterDeviceConnectionAction {
    /// ID of the device.
    device_id: DeviceId,
    /// ID of the cluster node.
    node_id: ClusterNodeId,
    /// Pre-generated ID of the connection.
    connection_id: DeviceConnectionId,
}

/// Output of registering a connection of a device to a cluster node.
record RegisterDeviceConnectionOutput {
    /// ID of the connection.
    connection_id: DeviceConnectionId,
}

/// Unregister a connection of a device to a cluster node.
#[request(name = "devices_UnregisterConnection", response = Empty)]
record UnregisterDeviceConnectionAction {
    /// ID of the connection.
    connection_id: DeviceConnectionId,
    /// Reason for ending the connection.
    end_reason: ConnectionEndReason,
}

/// Query the connection history of a device.
#[request(
    name = "devices_QueryConnections",
    response = QueryDeviceConnectionsOutput
)]
record QueryDeviceConnectionsAction {
    /// ID of the device.
    device_id: DeviceId,
    /// Limit results (default 100).
    #[validate({ 1 <= _ <= 1000 }, message = "Limit must be between 1 and 1000.")]
    limit?: u32,
    /// Include only active connections.
    active_only?: bool,
}

/// Output of querying device connections.
record QueryDeviceConnectionsOutput {
    /// List of connections.
    connections: [DeviceConnectionLog],
}

/// Issue a HTTP proxy JWT.
#[request(
    name = "devices_IssueHttpProxyToken",
    response = IssueDeviceHttpProxyTokenOutput
)]
record IssueDeviceHttpProxyTokenAction {
    /// ID of the device.
    device_id: DeviceId,
    /// Token validity duration in seconds.
    #[validate(
        { 1 <= _ <= 31536000 },
        message = "Token validity must be between 1 second and 1 year."
    )]
    valid_for_secs?: u32,
    /// Hostname to accept requests for.
    ///
    /// Defaults to a device-specific pseudo-random subdomain of the instance domain.
    #[validate(
        { 1 <= _.size <= 253 },
        message = "Hostname must be between 1 and 253 characters."
    )]
    #[validate(
        { matches(_, "^[A-Za-z0-9][A-Za-z0-9.-]*$") },
        message = "Hostname must be a valid DNS hostname.",
        code = "format:hostname"
    )]
    hostname?: string,
    /// Device port to proxy to.
    ///
    /// Defaults to `80`.
    #[validate(
        { 1 <= _ <= 65535 },
        message = "Port must be between 1 and 65535."
    )]
    port?: u16,
    /// Redirect URL in case the token is expired or invalid.
    #[validate(
        { 1 <= _.size <= 2048 },
        message = "Redirect URL must be between 1 and 2048 characters."
    )]
    redirect?: string,
}

/// Output of issuing a HTTP proxy JWT.
record IssueDeviceHttpProxyTokenOutput {
    /// JWT proxy token.
    jwt: Jwt,
    /// Proxy URL.
    url: string,
}

/// Validate a HTTP proxy JWT.
#[request(
    name = "devices_ValidateHttpProxyToken",
    response = ValidateDeviceHttpProxyTokenOutput
)]
record ValidateDeviceHttpProxyTokenAction {
    /// JWT to validate.
    jwt: Jwt,
}

/// Output of validating a HTTP proxy JWT.
#[json(tag = "result")]
variant ValidateDeviceHttpProxyTokenOutput {
    /// The JWT is invalid.
    Invalid: ValidateDeviceHttpProxyTokenInvalid,
    /// The JWT is valid.
    Valid: ValidateDeviceHttpProxyTokenSuccess,
}

/// Validation of a HTTP proxy JWT failed.
record ValidateDeviceHttpProxyTokenInvalid {
    /// URL to redirect to.
    redirect?: string,
}

/// Successful validation of a HTTP proxy JWT.
record ValidateDeviceHttpProxyTokenSuccess {
    /// ID of the device.
    device_id: DeviceId,
    /// Hostname to accept requests for.
    hostname?: string,
    /// Device port to proxy to.
    port?: u16,
}

/// Publish device events.
#[request(name = "devices_PublishEvents", response = Empty)]
record PublishDeviceEventsAction {
    /// ID of the device.
    device_id: DeviceId,
    /// Events to push.
    events: [DeviceEvent],
}

/// Query device events.
#[request(name = "devices_QueryEvents", response = QueryDeviceEventsOutput)]
record QueryDeviceEventsAction {
    /// ID of the device.
    device_id: DeviceId,
    /// Limit the number of events to return.
    ///
    /// Default to `100`.
    #[validate({ 1 <= _ <= 1000 }, message = "Limit must be between 1 and 1000.")]
    limit?: u32,
}

/// Output of querying device events.
record QueryDeviceEventsOutput {
    /// List of events.
    events: [DeviceEvent],
}

/// Event emitted by a device.
record DeviceEvent {
    /// ID of the event.
    event_id: DeviceEventId,
    /// Event category (optional, low-cardinality category of the event).
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Event category must be between 1 and 128 characters."
    )]
    category?: string,
    /// Severity of the event.
    severity: DeviceEventSeverity,
    /// Event body.
    body: JsonValue,
    /// Event attributes.
    attributes: [string: JsonValue],
    /// Timestamp when the event was emitted.
    emitted_at: Timestamp,
    /// Timestamp when the event was received.
    received_at?: Timestamp,
}

/// Severity of a device event.
#[json(tagged = externally)]
variant DeviceEventSeverity {
    /// Tracing event.
    Trace,
    /// Debugging event.
    Debug,
    /// Informational even.
    Info,
    /// Warning event.
    Warning,
    /// Error event.
    Error,
    /// Critical event.
    Critical,
}

/// Set a property of a device.
#[request(name = "devices_SetProperty", response = SetDevicePropertyOutput)]
record SetDevicePropertyAction {
    /// ID of the device.
    device_id: DeviceId,
    /// Name of the property.
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Property name must be between 1 and 256 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Property name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:property_name"
    )]
    name: string,
    /// Value of the property.
    value: JsonValue,
    /// Indicates whether the property should be protected.
    protected?: bool,
    /// If set, the property is only updated when its current version matches
    /// this value (compare-and-swap). Returns `VersionConflict` when the
    /// version does not match, or `Deleted` when the property no longer exists.
    expected_version?: u64,
}

/// Output of setting a device property.
#[json(tag = "result")]
variant SetDevicePropertyOutput {
    /// The property was set successfully.
    Set,
    /// The property was not updated because its version did not match the
    /// expected version (compare-and-swap conflict).
    VersionConflict: SetDevicePropertyVersionConflict,
    /// The property was not updated because it has been deleted while an
    /// expected version was specified.
    Deleted,
}

/// Details of a version conflict when setting a device property.
record SetDevicePropertyVersionConflict {
    /// The current version of the property.
    current_version: u64,
}

/// Get a property of a device.
#[request(name = "devices_GetProperty", response = GetDevicePropertyOutput)]
record GetDevicePropertyAction {
    /// ID of the device.
    device_id: DeviceId,
    /// Name of the property.
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Property name must be between 1 and 256 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Property name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:property_name"
    )]
    name: string,
}

/// Output of getting a property of a device.
#[json(tag = "result")]
variant GetDevicePropertyOutput {
    /// The property was not found.
    NotFound,
    /// The property was found.
    Found: DeviceProperty,
}

/// Remove a property from a device.
#[request(name = "devices_RemoveProperty", response = RemoveDevicePropertyOutput)]
record RemoveDevicePropertyAction {
    /// ID of the device.
    device_id: DeviceId,
    /// Name of the property.
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Property name must be between 1 and 256 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Property name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:property_name"
    )]
    name: string,
}

/// Output of removing a property from a device.
#[json(tag = "result")]
variant RemoveDevicePropertyOutput {
    /// The property was not found.
    NotFound,
    /// The property was removed.
    Removed,
}

/// Query the properties of a device.
#[request(
    name = "devices_QueryProperties",
    response = QueryDevicePropertiesOutput
)]
record QueryDevicePropertiesAction {
    /// ID of the device.
    device_id: DeviceId,
}

/// Output of querying the properties of a device.
record QueryDevicePropertiesOutput {
    /// List of properties.
    properties: [string: DeviceProperty],
}

/// Device property.
record DeviceProperty {
    /// Name of the property.
    name: string,
    /// Value of the property.
    value: JsonValue,
    /// Indicates whether the property is protected.
    protected: bool,
    /// Incremental version number, incremented on each update.
    version: u64,
    /// Last time the property was updated.
    last_updated: Timestamp,
}

/// Query the audit log of a device.
#[request(name = "devices_QueryAuditLog", response = QueryDeviceAuditLogOutput)]
record QueryDeviceAuditLogAction {
    /// ID of the device.
    device_id: DeviceId,
}

/// Output of querying the audit log of a device.
record QueryDeviceAuditLogOutput {
    /// List of audit log events.
    events: [AuditLogEvent],
}

/// Query the on-demand commands supported by a device.
#[unstable(feature = "device_commands")]
#[request(name = "devices_QueryCommands", response = QueryDeviceCommandsOutput)]
record QueryDeviceCommandsAction {
    /// ID of the device.
    device_id: DeviceId,
}

/// Output of querying device commands.
#[unstable(feature = "device_commands")]
record QueryDeviceCommandsOutput {
    /// Command manifest.
    manifest: DeviceCommandManifest,
}

/// Status of a device command invocation.
#[unstable(feature = "device_commands")]
#[json(tagged = externally)]
variant DeviceCommandStatus {
    /// Command completed successfully.
    Ok,
    /// Command failed.
    Error,
}

/// Hub-to-device frame.
#[unstable(feature = "device_commands")]
#[json(tag = "type")]
variant DeviceCommandHubFrame {
    /// Invoke a command.
    Invoke: DeviceCommandInvokeData,
}

/// Command invocation parameters.
#[unstable(feature = "device_commands")]
record DeviceCommandInvokeData {
    /// Command name.
    command: string,
    /// Command input.
    input: JsonValue,
    /// Stream log output back to the hub during execution (defaults to false).
    stream_log?: bool,
    /// Timeout in seconds.
    timeout_secs?: u32,
}

/// Device-to-hub frame.
#[unstable(feature = "device_commands")]
#[json(tag = "type")]
variant DeviceCommandDeviceFrame {
    /// Diagnostic log lines from the command.
    Log: DeviceCommandLogData,
    /// Command finished executing.
    Done: DeviceCommandDoneData,
}

/// Log data.
#[unstable(feature = "device_commands")]
record DeviceCommandLogData {
    /// Lines of diagnostic output from the command.
    lines: [string],
}

/// Command completion.
#[unstable(feature = "device_commands")]
record DeviceCommandDoneData {
    /// Completion status.
    status: DeviceCommandStatus,
    /// Command output.
    output?: JsonValue,
    /// Error message (present on failure).
    #[validate(
        { _.size <= 4096 },
        message = "Error message must be at most 4096 characters."
    )]
    error?: string,
    /// Last lines of the command's diagnostic log output.
    log_tail: [string],
    /// Execution duration in milliseconds.
    duration_ms: u64,
}

// ============================================================================
// Device Operations
// ============================================================================


/// Unique ID of a device operation.
#[rust(type = "nexigon_ids::ids::DeviceOperationId")]
#[json(type = "string")]
opaque DeviceOperationId

/// Unique claim for one lease of a device operation work item.
#[rust(type = "nexigon_ids::ids::DeviceOperationWorkClaimId")]
#[json(type = "string")]
opaque DeviceOperationWorkClaimId

/// One step in a device operation.
#[json(tag = "kind")]
variant DeviceOperationStep {
    /// Set a device property from the hub.
    SetDeviceProperty: DeviceOperationSetDevicePropertyStep,
    /// Update a device property from the hub.
    UpdateDeviceProperty: DeviceOperationUpdateDevicePropertyStep,
    /// Remove a device property from the hub.
    RemoveDeviceProperty: DeviceOperationRemoveDevicePropertyStep,
    /// Ask the device to run an on-device command when it polls.
    DeviceCommand: DeviceOperationDeviceCommandStep,
    /// Durable work for a worker running locally on the device.
    ///
    /// **Not executed by the bundled agent.** The hub protocol is complete: a device
    /// client may explicitly poll for task work, report progress and checkpoints, and
    /// resume the current step from its latest checkpoint. Nexigon Agent deliberately
    /// requests command work only.
    ///
    /// There is not yet an agent CLI or local-API task executor. Without a custom
    /// on-device client, an operation that reaches this step remains running until its
    /// timeout.
    DeviceTask: DeviceOperationDeviceTaskStep,
    /// Wait until a device-reported property predicate matches.
    WaitForDeviceProperty: DeviceOperationWaitForDevicePropertyStep,
}

/// Server-side device property set.
record DeviceOperationSetDevicePropertyStep {
    /// Run the step only when this expression evaluates to JSON `true`.
    /// A false result skips the step; an evaluation error fails it.
    when?: JsonExpr,
    /// Property name.
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Property name must be between 1 and 256 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Property name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:property_name"
    )]
    name: string,
    /// Desired property value.
    value: JsonValue,
    /// Whether the property should be protected.
    protected?: bool,
}

/// Server-side device property update.
record DeviceOperationUpdateDevicePropertyStep {
    /// Run the step only when this expression evaluates to JSON `true`.
    /// A false result skips the step; an evaluation error fails it.
    when?: JsonExpr,
    /// Property name.
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Property name must be between 1 and 256 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Property name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:property_name"
    )]
    name: string,
    /// Mutation to apply to the current property value.
    mutation: JsonMutation,
    /// Whether the property should be protected.
    ///
    /// When omitted, the existing protection flag is preserved. If the property
    /// does not exist yet, it defaults to unprotected.
    protected?: bool,
}

/// Server-side device property removal.
record DeviceOperationRemoveDevicePropertyStep {
    /// Run the step only when this expression evaluates to JSON `true`.
    /// A false result skips the step; an evaluation error fails it.
    when?: JsonExpr,
    /// Property name.
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Property name must be between 1 and 256 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Property name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:property_name"
    )]
    name: string,
}

/// Device-polled command step.
record DeviceOperationDeviceCommandStep {
    /// Run the step only when this expression evaluates to JSON `true`.
    /// A false result skips the step; an evaluation error fails it.
    when?: JsonExpr,
    /// Command name from the device command manifest.
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Command name must be between 1 and 256 characters."
    )]
    command: string,
    /// Command input.
    input: JsonValue,
    /// Step deadline in seconds. Defaults to one hour.
    ///
    /// The hub starts this clock when the command step becomes current work
    /// for the device. The same value is also passed to the device command
    /// handler as its execution timeout. If the device does not report before
    /// the deadline, the operation driver marks the step and operation as timed out.
    ///
    /// The deadline is *noticed* by a background driver tick rather than at the
    /// instant it passes, so a step times out within one tick of its deadline, not
    /// exactly on it. Timeouts far shorter than the tick interval will therefore
    /// overshoot considerably.
    #[validate(
        { 1 <= _ <= 86400 },
        message = "Command timeout must be between 1 second and 1 day."
    )]
    timeout_secs?: u32,
}

/// Durable device task step.
///
/// The Hub exposes task polling, progress, checkpoint, and report semantics for custom
/// on-device clients. The bundled Nexigon agent requests command work only and has no
/// task executor, so without such a client this step remains running until its timeout.
record DeviceOperationDeviceTaskStep {
    /// Run the step only when this expression evaluates to JSON `true`.
    /// A false result skips the step; an evaluation error fails it.
    when?: JsonExpr,
    /// Task name.
    ///
    /// A task is durable work scoped to this device operation step and intended for an
    /// on-device worker. The bundled agent has no task executor; see
    /// [`DeviceOperationStep::DeviceTask`].
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Device task name must be between 1 and 256 characters."
    )]
    task: string,
    /// Task input.
    input: JsonValue,
    /// Step deadline in seconds. Defaults to one day.
    ///
    /// The hub starts this clock when the task step becomes current work for
    /// the device. If no terminal outcome is reported before the deadline,
    /// the operation driver marks the step and operation as timed out. The deadline
    /// is noticed by a background driver tick rather than at the instant it passes,
    /// so a step times out within one tick of its deadline, not exactly on it. A restarted
    /// worker may resume from the latest checkpoint while the same step is
    /// still current.
    #[validate(
        { 1 <= _ <= 604800 },
        message = "Device task timeout must be between 1 second and 7 days."
    )]
    timeout_secs?: u32,
}

/// Server-observed property wait step.
record DeviceOperationWaitForDevicePropertyStep {
    /// Run the step only when this expression evaluates to JSON `true`.
    /// A false result skips the step; an evaluation error fails it.
    when?: JsonExpr,
    /// Expression that must evaluate to JSON `true` to complete the wait.
    ///
    /// A missing named value or path keeps the step waiting because the device
    /// may report it later. Any other evaluation error fails the step.
    predicate: JsonExpr,
    /// Optional deadline in seconds.
    ///
    /// The hub starts this clock when the wait step becomes current for the
    /// device. If the predicate does not match before the deadline,
    /// the operation driver marks the step and operation as timed out.
    #[validate(
        { 1 <= _ <= 604800 },
        message = "Wait timeout must be between 1 second and 7 days."
    )]
    timeout_secs?: u32,
}

/// Device operation lifecycle status.
#[json(tagged = externally)]
variant DeviceOperationStatus {
    /// Operation is ready but has not started executing steps.
    Pending,
    /// Operation is currently applying steps.
    Running,
    /// Operation completed all steps.
    Succeeded,
    /// Operation failed a step.
    Failed,
    /// Operation exceeded a step deadline.
    TimedOut,
    /// Operation was cancelled.
    Cancelled,
}

/// Step execution status.
#[json(tagged = externally)]
variant DeviceOperationStepStatus {
    /// Step has not been started.
    Pending,
    /// Step is waiting for device execution or a property predicate.
    Running,
    /// Step succeeded.
    Succeeded,
    /// Step failed.
    Failed,
    /// Step exceeded its deadline.
    TimedOut,
    /// Step was skipped by conditions.
    Skipped,
}

/// Summary of a device operation.
record DeviceOperationSummary {
    /// ID of the operation.
    device_operation_id: DeviceOperationId,
    /// Project the device belongs to.
    project_id: ProjectId,
    /// Device the operation is bound to.
    device_id: DeviceId,
    /// Actor that created the operation.
    ///
    /// For an operation created directly against a device, this is whoever created it. For
    /// one belonging to a fleet operation, it is whoever created *that*, since the rollout
    /// is what caused the work to exist. Either way it answers "who is responsible for this
    /// device doing this", which is what a reader of a device's history wants to know.
    created_by?: Actor,
    /// Fleet operation that materialized this operation, if any.
    ///
    /// Absent for operations created directly against the device.
    fleet_operation_id?: FleetOperationId,
    /// Operation name.
    ///
    /// A standalone device operation owns this name. A fleet-owned device operation
    /// inherits it from its fleet operation.
    name: string,
    /// Optional description.
    description?: string,
    /// Lifecycle status.
    status: DeviceOperationStatus,
    /// Current step index.
    step_index: u32,
    /// Number of configured steps.
    step_count: u32,
    /// Last step or operation error.
    last_error?: string,
    /// Creation time.
    created_at: Timestamp,
    /// Start time.
    started_at?: Timestamp,
    /// Completion time.
    completed_at?: Timestamp,
    /// Last update time.
    updated_at: Timestamp,
}

/// Device operation details.
record DeviceOperationDetails {
    /// Summary.
    summary: DeviceOperationSummary,
    /// Ordered steps.
    steps: [DeviceOperationStep],
    /// State for steps that have started, one entry per step reached so far.
    ///
    /// A step with no entry here has not been reached yet. Correlate entries
    /// with `steps` by `step_index`, not array position or length — this list
    /// isn't guaranteed to stay dense or gapless as a matter of API contract,
    /// even though the current driver happens to fill it in strictly in
    /// order.
    step_states: [DeviceOperationStepState],
}

/// Persisted state for one device operation step.
///
/// Look up `DeviceOperationDetails.steps[step_index]` for the step's kind and
/// configuration; this only carries the step's execution state.
record DeviceOperationStepState {
    /// Index into `DeviceOperationDetails.steps` of the step this state is for.
    step_index: u32,
    /// Step execution status.
    status: DeviceOperationStepStatus,
    /// Step or device-reported command output.
    output?: JsonValue,
    /// Error message when the step failed or timed out.
    error?: string,
    /// When the step started running.
    started_at?: Timestamp,
    /// When the step reached a terminal status.
    completed_at?: Timestamp,
    /// Durable checkpoint reported by the device while running a task step.
    ///
    /// Only ever set for `DeviceTask` steps; always absent for every other
    /// step kind, since only device tasks can report checkpoints (see
    /// `ReportDeviceOperationStepAction`).
    checkpoint?: JsonValue,
}

/// Work item returned to a device when it polls.
record DeviceOperationWorkItem {
    device_operation_id: DeviceOperationId,
    /// Claim that must accompany reports for this delivery of the work.
    ///
    /// A later poll after the lease expires replaces this claim, fencing reports from
    /// the older worker.
    claim_id: DeviceOperationWorkClaimId,
    /// Name of the standalone or fleet operation that defined this work.
    operation_name: string,
    step_index: u32,
    /// Durable checkpoint from a previous report for this step.
    checkpoint?: JsonValue,
    step: DeviceOperationWorkStep,
}

/// Device-executable operation step.
#[json(tag = "kind")]
variant DeviceOperationWorkStep {
    /// Run an on-device command and report its result.
    DeviceCommand: DeviceOperationDeviceCommandStep,
    /// Durable task work, for the device to run and checkpoint.
    DeviceTask: DeviceOperationDeviceTaskStep,
}

/// Kind of device operation work to return from a poll.
#[json(tagged = externally)]
variant DeviceOperationWorkKind {
    /// Command work intended for the Nexigon agent command runner.
    DeviceCommand,
    /// Durable task work. Not requested by the bundled Nexigon agent; see
    /// `DeviceOperationStep::DeviceTask`.
    DeviceTask,
}

/// Report from a device after executing a polled step.
record DeviceOperationStepReport {
    /// Result status.
    status: DeviceOperationStepReportStatus,
    /// Command or step output.
    output?: JsonValue,
    /// Durable checkpoint to return with future work polls for this step.
    checkpoint?: JsonValue,
    /// Error message when the step failed.
    #[validate(
        { _.size <= 4096 },
        message = "Error message must be at most 4096 characters."
    )]
    error?: string,
}

/// Device-reported step result status.
#[json(tagged = externally)]
variant DeviceOperationStepReportStatus {
    /// Step is still running and the report carries intermediate progress.
    Running,
    /// Step succeeded.
    Succeeded,
    /// Step failed.
    Failed,
}

/// Query device operations for a device.
#[request(
    name = "devices_QueryOperations",
    response = QueryDeviceOperationsOutput
)]
record QueryDeviceOperationsAction {
    /// ID of the device.
    device_id: DeviceId,
}

/// Output of querying device operations.
record QueryDeviceOperationsOutput {
    /// Device operations.
    operations: [DeviceOperationSummary],
}

/// Get device operation details.
#[request(name = "devices_GetOperation", response = GetDeviceOperationOutput)]
record GetDeviceOperationAction {
    /// ID of the operation.
    device_operation_id: DeviceOperationId,
}

/// Output of getting device operation details.
#[json(tag = "result")]
variant GetDeviceOperationOutput {
    /// Operation was not found or the actor cannot access it.
    NotFound,
    /// Operation was found.
    Found: DeviceOperationDetails,
}

/// Create a device operation.
#[request(
    name = "devices_CreateOperation",
    response = CreateDeviceOperationOutput
)]
record CreateDeviceOperationAction {
    /// Device the operation is bound to.
    device_id: DeviceId,
    /// Operation name.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Device operation name must be between 1 and 128 characters."
    )]
    name: string,
    /// Optional description.
    #[validate(
        { _.size <= 4096 },
        message = "Device operation description must be at most 4096 characters."
    )]
    description?: string,
    /// Ordered steps.
    steps: [DeviceOperationStep],
}

/// Output of creating a device operation.
record CreateDeviceOperationOutput {
    /// ID of the created operation.
    device_operation_id: DeviceOperationId,
}

/// Start a pending device operation.
#[request(name = "devices_StartOperation", response = Empty)]
record StartDeviceOperationAction {
    /// ID of the operation.
    device_operation_id: DeviceOperationId,
}

/// Cancel a device operation.
#[request(name = "devices_CancelOperation", response = Empty)]
record CancelDeviceOperationAction {
    /// ID of the operation.
    device_operation_id: DeviceOperationId,
}

/// Atomically claim device operation work for a device.
#[request(name = "devices_ClaimOperationWork", response = ClaimDeviceOperationWorkOutput)]
record ClaimDeviceOperationWorkAction {
    /// ID of the device claiming work.
    device_id: DeviceId,
    /// Maximum number of work items to claim. Defaults to 1.
    #[validate(
        { 1 <= _ <= 20 },
        message = "Claim limit must be between 1 and 20."
    )]
    limit?: u32,
    /// Work kinds to return. Defaults to all device-executable work.
    kinds?: [DeviceOperationWorkKind],
}

/// Output of claiming operation work for a device.
record ClaimDeviceOperationWorkOutput {
    /// Work items leased to the device.
    work: [DeviceOperationWorkItem],
}

/// Report the result of a device operation step.
///
/// Repeating a report after it was already applied is a successful no-op. A report whose
/// claim has been superseded is also ignored, so an expired worker cannot overwrite the
/// current attempt.
#[request(name = "devices_ReportOperationStep", response = Empty)]
record ReportDeviceOperationStepAction {
    /// ID of the reporting device.
    device_id: DeviceId,
    /// ID of the operation.
    device_operation_id: DeviceOperationId,
    /// Step index being reported.
    step_index: u32,
    /// Claim returned by the poll that delivered this work item.
    claim_id: DeviceOperationWorkClaimId,
    /// Reported step outcome.
    report: DeviceOperationStepReport,
}
