//! Actions and types related to projects.

import audit::AuditLogEvent
import datetime::Timestamp
import devices::DeviceFingerprint
import devices::DeviceId
import devices::DeviceStatus
import organizations::OrganizationId
import outputs::Empty
import repositories::RepositoryId

/// Unique ID of a project.
#[rust(type = "nexigon_ids::ids::ProjectId")]
#[json(type = "string")]
opaque ProjectId

/// Unique ID of a deployment token.
#[rust(type = "nexigon_ids::ids::DeploymentTokenId")]
#[json(type = "string")]
opaque DeploymentTokenId

/// Unique ID of a device pairing key.
#[rust(type = "nexigon_ids::ids::DevicePairingKeyId")]
#[json(type = "string")]
opaque DevicePairingKeyId

/// Deployment token.
#[rust(type = "nexigon_ids::ids::DeploymentToken")]
#[json(type = "string")]
opaque DeploymentToken

/// Query the projects of the instance.
#[request(name = "projects_Query", response = QueryProjectsOutput)]
record QueryProjectsAction {}

/// Output of querying the projects of the instance.
record QueryProjectsOutput {
    /// List of projects.
    projects: [QueryProjectsItem],
}

/// Project item.
record QueryProjectsItem {
    /// ID of the project.
    project_id: ProjectId,
    /// Name of the project.
    name: string,
}

/// Get information about a project.
#[request(name = "projects_GetDetails", response = GetProjectDetailsOutput)]
record GetProjectDetailsAction {
    /// ID of the project.
    project_id: ProjectId,
}

/// Information about a project.
record GetProjectDetailsOutput {
    /// ID of the project.
    project_id: ProjectId,
    /// Name of the project.
    name: string,
    /// Number of devices in the project.
    device_count: u32,
}

/// Set the name of a project.
#[request(name = "projects_SetName", response = Empty)]
record SetProjectNameAction {
    /// ID of the project.
    project_id: ProjectId,
    /// New name of the project.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Project name must be between 1 and 128 characters."
    )]
    name: string,
}

/// Create a new project.
#[request(name = "projects_Create", response = CreateProjectOutput)]
record CreateProjectAction {
    /// Organization to create the project in.
    organization_id: OrganizationId,
    /// Name of the project.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Project name must be between 1 and 128 characters."
    )]
    name: string,
}

/// Output of creating a project.
#[json(tag = "result")]
variant CreateProjectOutput {
    Created: CreateProjectSuccess,
}

/// Project creation has been successful.
record CreateProjectSuccess {
    /// ID of the project.
    project_id: ProjectId,
}

/// Delete a project.
#[request(name = "projects_Delete", response = Empty)]
record DeleteProjectAction {
    /// ID of the project.
    project_id: ProjectId,
}

/// Query the devices of a project.
#[request(name = "projects_QueryDevices", response = QueryProjectDevicesOutput)]
record QueryProjectDevicesAction {
    /// ID of the project.
    project_id: ProjectId,
}

/// Output of querying the devices of a project.
record QueryProjectDevicesOutput {
    /// List of devices.
    devices: [QueryProjectDevicesItem],
}

/// Device item.
record QueryProjectDevicesItem {
    /// ID of the device.
    device_id: DeviceId,
    /// Name of the device.
    name?: string,
    /// Hostname reported by the device (from `dev.nexigon.system.info`).
    hostname?: string,
    /// Timestamp when the device was first seen.
    first_seen: Timestamp,
    /// Combined device status (connection + health).
    status: DeviceStatus,
    /// Indicates whether the device is online.
    is_connected: bool,
    /// Pending device certificates.
    pending_certificates_count: u32,
    /// Timestamp when the device was last connected (current or most recent connection).
    last_connected_at?: Timestamp,
    /// Duration of the current connection in seconds (null if not connected).
    current_connection_duration_secs?: u32,
}

/// Query the deployment tokens of a project.
#[request(
    name = "projects_QueryDeploymentTokens",
    response = QueryProjectDeploymentTokensOutput
)]
record QueryProjectDeploymentTokensAction {
    /// ID of the project.
    project_id: ProjectId,
}

/// Output of querying the deployment tokens of a project.
record QueryProjectDeploymentTokensOutput {
    /// List of deployment tokens.
    tokens: [QueryProjectDeploymentTokensItem],
}

/// Deployment token item.
record QueryProjectDeploymentTokensItem {
    /// ID of the token.
    token_id: DeploymentTokenId,
    /// Device this deployment token is bound to, if any.
    device_id?: DeviceId,
    /// Creation date of the token.
    created_at: Timestamp,
    /// Name of the token.
    name?: string,
    /// Flags.
    flags: DeploymentTokenFlags,
}

/// Query repositories of a project.
#[request(
    name = "projects_QueryLinkedRepositories",
    response = QueryProjectRepositoriesOutput
)]
record QueryProjectRepositoriesAction {
    /// ID of the project.
    project_id: ProjectId,
}

/// Output of querying the repositories of a project.
record QueryProjectRepositoriesOutput {
    /// List of repositories.
    repositories: [QueryProjectRepositoriesItem],
}

/// Repository item.
record QueryProjectRepositoriesItem {
    /// ID of the repository.
    repository_id: RepositoryId,
    /// Display name of the repository.
    display_name: string,
    /// URL-safe slug of the repository, if one has been set.
    slug?: string,
    /// Public name of the repository.
    ///
    /// Falls back to the repository ID when no slug is set.
    #[deprecated(
        note = "Use `slug`, which is absent when no slug is set.",
        remove_in = "2029.2"
    )]
    public_name: string,
}

/// Flags for deployment tokens.
record DeploymentTokenFlags {
    /// Whether to automatically accept new devices.
    auto_accept?: bool,
}

/// Create a deployment token.
#[request(
    name = "projects_CreateDeploymentToken",
    response = CreateDeploymentTokenOutput
)]
record CreateDeploymentTokenAction {
    /// ID of the project.
    project_id: ProjectId,
    /// Name of the token.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Token name must be between 1 and 128 characters."
    )]
    name: string,
    /// Flags.
    flags?: DeploymentTokenFlags,
}

/// Output of creating a deployment token.
record CreateDeploymentTokenOutput {
    /// ID of the token.
    token_id: DeploymentTokenId,
    /// Token.
    token: DeploymentToken,
}

/// Delete a deployment token.
#[request(name = "projects_DeleteDeploymentToken", response = Empty)]
record DeleteDeploymentTokenAction {
    /// ID of the token.
    token_id: DeploymentTokenId,
}

/// Set the flags of a deployment token.
#[request(name = "projects_SetDeploymentTokenFlags", response = Empty)]
record SetDeploymentTokenFlagsAction {
    /// ID of the token.
    token_id: DeploymentTokenId,
    /// Flags.
    flags: DeploymentTokenFlags,
}

/// Query the device pairing keys of a project.
#[request(
    name = "projects_QueryDevicePairingKeys",
    response = QueryDevicePairingKeysOutput
)]
record QueryDevicePairingKeysAction {
    /// ID of the project.
    project_id: ProjectId,
}

/// Output of querying the device pairing keys of a project.
record QueryDevicePairingKeysOutput {
    /// List of device pairing keys.
    pairing_keys: [QueryDevicePairingKeysItem],
}

/// Device pairing key item.
record QueryDevicePairingKeysItem {
    /// ID of the pairing key.
    pairing_key_id: DevicePairingKeyId,
    /// Public lookup selector (first six normalized characters of the key).
    selector: string,
    /// Creation date of the pairing key.
    created_at: Timestamp,
    /// Expiration date of the pairing key.
    expires_at: Timestamp,
    /// Timestamp when the pairing key was redeemed.
    used_at?: Timestamp,
    /// Timestamp when the pairing key was revoked.
    revoked_at?: Timestamp,
    /// Name of the pairing key.
    name?: string,
    /// Device created or associated when the pairing key was redeemed.
    device_id?: DeviceId,
    /// Deployment token issued when the pairing key was redeemed.
    token_id?: DeploymentTokenId,
}

/// Create a device pairing key.
#[request(
    name = "projects_CreateDevicePairingKey",
    response = CreateDevicePairingKeyOutput
)]
record CreateDevicePairingKeyAction {
    /// ID of the project.
    project_id: ProjectId,
    /// Name of the pairing key.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Pairing key name must be between 1 and 128 characters."
    )]
    name?: string,
    /// Pairing key validity duration in seconds.
    ///
    /// Defaults to 5 minutes. The maximum is 10 minutes.
    #[validate(
        { 1 <= _ <= 600 },
        message = "Pairing key validity must be between 1 second and 10 minutes."
    )]
    valid_for_secs?: u32,
}

/// Output of creating a device pairing key.
record CreateDevicePairingKeyOutput {
    /// ID of the pairing key.
    pairing_key_id: DevicePairingKeyId,
    /// Pairing key. This is only returned once.
    pairing_key: string,
    /// Public lookup selector (first six normalized characters of the key).
    selector: string,
    /// Creation date of the pairing key.
    created_at: Timestamp,
    /// Expiration date of the pairing key.
    expires_at: Timestamp,
}

/// Revoke an unused device pairing key.
#[request(name = "projects_RevokeDevicePairingKey", response = Empty)]
record RevokeDevicePairingKeyAction {
    /// ID of the pairing key.
    pairing_key_id: DevicePairingKeyId,
}

/// Redeem a device pairing key.
#[request(
    name = "projects_RedeemDevicePairingKey",
    response = RedeemDevicePairingKeyOutput
)]
record RedeemDevicePairingKeyAction {
    /// Pairing key as shown to the user.
    #[validate(
        { 10 <= _.size <= 11 },
        message = "Pairing key must be 10 characters, optionally formatted with one dash."
    )]
    pairing_key: string,
    /// Fingerprint generated by the device.
    fingerprint: DeviceFingerprint,
    /// Optional display name for the device.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Device name must be between 1 and 128 characters."
    )]
    device_name?: string,
}

/// Output of redeeming a device pairing key.
record RedeemDevicePairingKeyOutput {
    /// Project the device was created in.
    project_id: ProjectId,
    /// Device created for this pairing key.
    device_id: DeviceId,
    /// ID of the issued device-bound deployment token.
    token_id: DeploymentTokenId,
    /// Device-bound deployment token. This is only returned once.
    token: DeploymentToken,
}

/// Query the audit log of the project.
#[request(
    name = "audit_QueryAuditLogEvents",
    response = QueryAuditLogEventsOutput
)]
record QueryAuditLogEventsAction {
    /// ID of the project.
    project_id: ProjectId,
}

/// Output of querying the audit log of the project.
record QueryAuditLogEventsOutput {
    /// List of audit log events.
    events: [AuditLogEvent],
}

/// Add a repository to the project.
#[request(name = "projects_LinkRepository", response = Empty)]
record AddProjectRepositoryAction {
    /// ID of the project.
    project_id: ProjectId,
    /// ID of the repository.
    repository_id: RepositoryId,
}

/// Remove a repository from the project.
#[request(name = "projects_UnlinkRepository", response = Empty)]
record RemoveProjectRepositoryAction {
    /// ID of the project.
    project_id: ProjectId,
    /// ID of the repository.
    repository_id: RepositoryId,
}

/// OTLP event forwarding configuration for a project.
#[unstable(feature = "otlp_export")]
record ProjectOtlpConfig {
    /// Whether OTLP forwarding is enabled.
    enabled: bool,
    /// OTLP endpoint URL (e.g., https://otel-collector.example.com/v1/logs).
    #[validate(
        { 1 <= _.size <= 2048 },
        message = "OTLP endpoint must be between 1 and 2048 characters."
    )]
    #[validate(
        { matches(_, "^https?://") },
        message = "OTLP endpoint must be an HTTP(S) URL.",
        code = "format:url"
    )]
    endpoint?: string,
    /// HTTP headers to include with OTLP requests (e.g., for authentication).
    /// Values are masked when read back.
    headers: [string: string],
}

/// Get the OTLP event forwarding configuration for a project.
#[unstable(feature = "otlp_export")]
#[request(name = "projects_GetOtlpConfig", response = GetProjectOtlpConfigOutput)]
record GetProjectOtlpConfigAction {
    /// ID of the project.
    project_id: ProjectId,
}

/// Output of getting the OTLP configuration for a project.
#[unstable(feature = "otlp_export")]
record GetProjectOtlpConfigOutput {
    /// OTLP configuration.
    config: ProjectOtlpConfig,
}

/// Set the OTLP event forwarding configuration for a project.
#[unstable(feature = "otlp_export")]
#[request(name = "projects_SetOtlpConfig", response = Empty)]
record SetProjectOtlpConfigAction {
    /// ID of the project.
    project_id: ProjectId,
    /// OTLP configuration.
    config: ProjectOtlpConfig,
}
