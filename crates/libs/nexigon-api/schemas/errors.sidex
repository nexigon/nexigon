//! Error types.

/// Kind of an action error.
#[rust(derive(Copy))]
#[json(tagged = externally)]
variant ActionErrorKind {
    /// Invalid action.
    Invalid,
    /// Forbidden action.
    Forbidden,
    /// The action requires inline credential re-verification.
    OperationAuthorizationRequired,
    /// A scope policy requires authenticator enrollment before access.
    MfaEnrollmentRequired,
    /// Internal server error.
    Internal,
    /// Rate limit exceeded.
    RateLimited,
    /// Service or dependency capacity is temporarily unavailable.
    Unavailable,
}

/// Action error.
record ActionError {
    /// Kind of the error.
    kind: ActionErrorKind,
    /// Message of the error.
    message: string,
    /// Minimum number of seconds to wait before retrying.
    retry_after_seconds?: u64,
}

/// Action result.
#[json(tag = "result")]
variant ActionResult<T> {
    #[json(content = "value")]
    Ok: T,
    #[json(content = "error")]
    Error: ActionError,
}
