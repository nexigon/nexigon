//! Fleet-level actions and types.

import datetime::Timestamp
import devices::DeviceGroupSelector
import devices::DeviceId
import devices::DeviceOperationId
import devices::DeviceOperationStatus
import devices::DeviceOperationStep
import devices::DeviceOperationStepState
import devices::DeviceSelectionError
import json::JsonValue
import outputs::Empty
import pagination::PageInfo
import pagination::PageRequest
import projects::ProjectId
import projects::QueryProjectDevicesItem
import rollouts::RolloutGuardStatus
import rollouts::RolloutStage

/// Set a fleet property manually.
#[request(name = "fleet_SetProperty", response = Empty)]
record SetFleetPropertyAction {
    /// ID of the project.
    project_id: ProjectId,
    /// Name of the property.
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Property name must be between 1 and 256 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Property name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:property_name"
    )]
    name: string,
    /// Value of the property.
    value: JsonValue,
}

/// Get a fleet property by name.
#[request(name = "fleet_GetProperty", response = GetFleetPropertyOutput)]
record GetFleetPropertyAction {
    /// ID of the project.
    project_id: ProjectId,
    /// Name of the property.
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Property name must be between 1 and 256 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Property name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:property_name"
    )]
    name: string,
}

/// Output of getting a fleet property.
#[json(tag = "result")]
variant GetFleetPropertyOutput {
    /// The property was not found.
    NotFound,
    /// The property was found.
    Found: FleetProperty,
}

/// Remove a fleet property.
///
/// Handles both manual and computed properties. For computed properties, the
/// associated definition is removed as well.
#[request(name = "fleet_RemoveProperty", response = RemoveFleetPropertyOutput)]
record RemoveFleetPropertyAction {
    /// ID of the project.
    project_id: ProjectId,
    /// Name of the property.
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Property name must be between 1 and 256 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Property name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:property_name"
    )]
    name: string,
}

/// Output of removing a fleet property.
#[json(tag = "result")]
variant RemoveFleetPropertyOutput {
    /// The property was not found.
    NotFound,
    /// The property was removed.
    Removed,
}

/// Query all fleet properties of a project.
#[request(name = "fleet_QueryProperties", response = QueryFleetPropertiesOutput)]
record QueryFleetPropertiesAction {
    /// ID of the project.
    project_id: ProjectId,
}

/// Output of querying fleet properties.
record QueryFleetPropertiesOutput {
    /// Properties keyed by name.
    properties: [string: FleetProperty],
}

/// How a fleet property is managed.
#[json(tag = "kind")]
variant FleetPropertyKind {
    /// Set manually via the API.
    Manual,
    /// Computed from device properties via a user-defined strategy.
    #[unstable(feature = "fleet_computed_properties")]
    Computed,
    /// Computed from device properties via a built-in strategy.
    #[unstable(feature = "fleet_computed_properties")]
    Builtin,
}

/// A fleet property.
record FleetProperty {
    /// Name of the property.
    name: string,
    /// Current value.
    value: JsonValue,
    /// How this property is managed.
    kind: FleetPropertyKind,
    /// Incremental version number, bumped on each update.
    version: u64,
    /// Error from the last computation attempt, if any.
    error?: string,
    /// When the value was last updated.
    last_updated: Timestamp,
}

/// Define a computed fleet property.
#[unstable(feature = "fleet_computed_properties")]
#[request(name = "fleet_DefineComputedProperty", response = Empty)]
record DefineComputedFleetPropertyAction {
    /// ID of the project.
    project_id: ProjectId,
    /// Name of the property.
    #[validate(
        { 1 <= _.size <= 256 },
        message = "Property name must be between 1 and 256 characters."
    )]
    #[validate(
        { matches(_, "^[a-zA-Z0-9][a-zA-Z0-9._-]*$") },
        message = "Property name must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.",
        code = "format:property_name"
    )]
    name: string,
    /// Device property names fed into the strategy's map function.
    input_properties: [string],
    /// Name of the computation strategy.
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Strategy name must be between 1 and 128 characters."
    )]
    strategy: string,
    /// Strategy-specific configuration.
    config?: JsonValue,
}

/// Query computed fleet property definitions for a project.
#[unstable(feature = "fleet_computed_properties")]
#[request(
    name = "fleet_QueryComputedPropertyDefinitions",
    response = QueryComputedFleetPropertyDefinitionsOutput
)]
record QueryComputedFleetPropertyDefinitionsAction {
    /// ID of the project.
    project_id: ProjectId,
}

/// Output of querying computed fleet property definitions.
#[unstable(feature = "fleet_computed_properties")]
record QueryComputedFleetPropertyDefinitionsOutput {
    /// List of definitions.
    definitions: [ComputedFleetPropertyDefinition],
}

/// A computed fleet property definition.
#[unstable(feature = "fleet_computed_properties")]
record ComputedFleetPropertyDefinition {
    /// Name of the property.
    name: string,
    /// Device property names fed into the strategy's map function.
    input_properties: [string],
    /// Name of the computation strategy.
    strategy: string,
    /// Strategy-specific configuration.
    config: JsonValue,
    /// When the definition was created.
    created_at: Timestamp,
}

// ============================================================================
// Fleet Operations
// ============================================================================


/// Unique ID of a fleet operation.
#[rust(type = "nexigon_ids::ids::FleetOperationId")]
#[json(type = "string")]
opaque FleetOperationId

/// Devices that a fleet operation applies to. All supplied conditions must hold.
record FleetOperationTargetSelector {
    /// Devices that may match. Without this field, every device of the project
    /// may match.
    device_ids?: [DeviceId],
    /// Group conditions that devices must satisfy.
    groups?: DeviceGroupSelector,
    /// Expression that devices must satisfy. It can read the variables
    /// `properties` and `now`.
    ///
    /// A device for which the expression produces an error is not selected.
    /// The error is recorded as a selection error.
    #[validate(
        { _.size <= 4096 },
        message = "Expressions must be at most 4096 characters."
    )]
    expression?: string,
}

/// How a fleet operation selects its targets.
#[json(tagged = externally)]
variant FleetOperationEnrollment {
    /// Select the targets once, when the operation starts.
    Snapshot,
    /// Select the targets when the operation starts and then periodically,
    /// adding devices that start to match, until the operation is closed.
    Dynamic,
}

/// Lifecycle status of a fleet operation.
#[json(tagged = externally)]
variant FleetOperationStatus {
    /// The operation has been created but not started.
    Draft,
    /// The operation is running.
    Running,
    /// The operation is halted until it is resumed.
    Halted,
    /// All targets finished, none failed or timed out, and no selection errors
    /// remain.
    Completed,
    /// All targets finished, but some failed or timed out, or selection errors
    /// remain.
    Failed,
    /// The operation was cancelled.
    Cancelled,
}

/// Summary of a fleet operation.
record FleetOperationSummary {
    fleet_operation_id: FleetOperationId,
    project_id: ProjectId,
    name: string,
    description?: string,
    status: FleetOperationStatus,
    enrollment: FleetOperationEnrollment,
    /// Time that each target has to finish after its release, in seconds.
    deadline_secs?: u32,
    /// Numbers of the targets by status.
    progress: FleetOperationProgress,
    created_at: Timestamp,
    started_at?: Timestamp,
    /// Time when the operation was halted, while it is halted or if it was
    /// cancelled while halted.
    halted_at?: Timestamp,
    /// Time when a dynamic operation stopped selecting further targets.
    closed_at?: Timestamp,
    /// Time when the operation last selected targets.
    last_enrollment_at?: Timestamp,
    completed_at?: Timestamp,
}

/// Fleet operation with its definition and the progress of its stages.
record FleetOperationDetails {
    summary: FleetOperationSummary,
    selector: FleetOperationTargetSelector,
    /// Stages in the order of their release.
    stages: [FleetOperationStageState],
    /// Steps that each target runs.
    steps: [DeviceOperationStep],
}

/// Definition and progress of a fleet operation stage.
record FleetOperationStageState {
    definition: RolloutStage,
    /// Time when the stage was released. Absent until then.
    released_at?: Timestamp,
    /// Numbers of the stage's targets by status.
    targets: FleetOperationProgress,
    /// Progress of the stage's guard. Present for the next stage to release.
    ///
    /// A target counts as completed once it succeeded and as failed once it
    /// failed or timed out. Cancelled targets do not count.
    guard?: RolloutGuardStatus,
}

/// Numbers of targets by status. Targets of deleted devices are not counted.
record FleetOperationProgress {
    total: u32,
    pending: u32,
    running: u32,
    succeeded: u32,
    failed: u32,
    timed_out: u32,
    cancelled: u32,
}

/// A device for which the target selector's expression produced an error.
///
/// The device is not a target. A dynamic operation evaluates the selector for
/// the device again on its next selection of targets.
record FleetOperationSelectionError {
    device_id: DeviceId,
    /// Error that the expression produced.
    error: string,
    /// When the error was last observed.
    updated_at: Timestamp,
}

/// A device that a fleet operation applies to, and the progress of its device
/// operation.
record FleetOperationTarget {
    device_id: DeviceId,
    /// Device operation that runs the steps on the device.
    device_operation_id: DeviceOperationId,
    /// Index of the target's stage.
    stage_index: u32,
    /// Index of the step that the target is at.
    step_index: u32,
    status: DeviceOperationStatus,
    last_error?: string,
    /// Time when the target was released, during its stage's spread. Absent
    /// until then.
    released_at?: Timestamp,
    /// Time when the target times out unless it has finished.
    deadline_at?: Timestamp,
    updated_at: Timestamp,
    /// States of the steps that the target has reached. Correlate them with
    /// `FleetOperationDetails.steps` by `step_index`.
    step_states: [DeviceOperationStepState],
}

/// List the fleet operations of a project, newest first.
#[request(name = "fleet_QueryOperations", response = QueryFleetOperationsOutput)]
record QueryFleetOperationsAction {
    project_id: ProjectId,
}

/// Output of listing fleet operations.
record QueryFleetOperationsOutput {
    operations: [FleetOperationSummary],
}

/// Get a fleet operation.
#[request(name = "fleet_GetOperation", response = GetFleetOperationOutput)]
record GetFleetOperationAction {
    fleet_operation_id: FleetOperationId,
}

/// Output of getting a fleet operation.
#[json(tag = "result")]
variant GetFleetOperationOutput {
    /// The operation does not exist or the actor cannot access it.
    NotFound,
    /// The operation was found.
    Found: FleetOperationDetails,
}

/// Create a fleet operation as a draft.
#[request(name = "fleet_CreateOperation", response = CreateFleetOperationOutput)]
record CreateFleetOperationAction {
    project_id: ProjectId,
    #[validate(
        { 1 <= _.size <= 128 },
        message = "Fleet operation name must be between 1 and 128 characters."
    )]
    name: string,
    #[validate(
        { _.size <= 4096 },
        message = "Fleet operation description must be at most 4096 characters."
    )]
    description?: string,
    /// How the operation selects its targets. Defaults to `Snapshot`.
    enrollment?: FleetOperationEnrollment,
    /// Time that each target has to finish after its release, in seconds.
    /// Targets are released during their stage's spread. A target that has not
    /// finished in time times out. Without it, targets wait for their devices
    /// indefinitely.
    #[validate(
        { 1 <= _ <= 2592000 },
        message = "Deadline must be between 1 second and 30 days."
    )]
    deadline_secs?: u32,
    selector: FleetOperationTargetSelector,
    /// Stages in the order of their release.
    #[validate(
        { 1 <= _.size <= 20 },
        message = "A fleet operation must have between 1 and 20 stages."
    )]
    stages: [RolloutStage],
    /// Steps that each target runs.
    #[validate(
        { 1 <= _.size <= 64 },
        message = "A fleet operation must have between 1 and 64 steps."
    )]
    steps: [DeviceOperationStep],
}

/// Output of creating a fleet operation.
record CreateFleetOperationOutput {
    fleet_operation_id: FleetOperationId,
}

/// Preview the devices that a target selector currently matches.
///
/// A preview does not decide the targets of an operation. An operation selects
/// its targets when it starts and, if it is dynamic, periodically afterwards.
#[request(
    name = "fleet_PreviewOperationTargets",
    response = PreviewFleetOperationTargetsOutput
)]
record PreviewFleetOperationTargetsAction {
    project_id: ProjectId,
    selector: FleetOperationTargetSelector,
    /// Maximum number of devices and errors to return. Defaults to `20`.
    #[validate({ 1 <= _ <= 1000 }, message = "Limit must be between 1 and 1000.")]
    limit?: u32,
}

/// Output of previewing fleet operation targets.
record PreviewFleetOperationTargetsOutput {
    /// Number of matching devices.
    matching_count: u32,
    /// Newest matching devices, up to the requested limit.
    devices: [QueryProjectDevicesItem],
    /// Number of devices for which the expression produced an error.
    error_count: u32,
    /// Devices for which the expression produced an error, up to the requested
    /// limit.
    selection_errors: [DeviceSelectionError],
}

/// Start a draft fleet operation.
///
/// Selects the targets and releases the first stage.
#[request(name = "fleet_StartOperation", response = Empty)]
record StartFleetOperationAction {
    fleet_operation_id: FleetOperationId,
}

/// Halt a running fleet operation.
///
/// The operation selects no targets, releases no stages, and hands out no work
/// until it is resumed. Devices can still report the results of work that they
/// already claimed. The clocks of spreads, soak times, timeouts, and deadlines
/// do not advance while the operation is halted. Halting a halted operation has
/// no effect.
#[request(name = "fleet_HaltOperation", response = Empty)]
record HaltFleetOperationAction {
    fleet_operation_id: FleetOperationId,
}

/// Resume a halted fleet operation where it stopped.
///
/// Resuming a running operation has no effect.
#[request(name = "fleet_ResumeOperation", response = Empty)]
record ResumeFleetOperationAction {
    fleet_operation_id: FleetOperationId,
}

/// Release the next stage of a running fleet operation, skipping its guard and
/// the wait for the previous stage's spread.
#[request(name = "fleet_ReleaseOperationStage", response = Empty)]
record ReleaseFleetOperationStageAction {
    fleet_operation_id: FleetOperationId,
    /// Index of the stage to release, which must be the next unreleased one.
    stage_index: u32,
}

/// Stop a dynamic fleet operation from selecting further targets.
///
/// The operation finishes once all of its stages are released and all of its
/// targets have finished.
#[request(name = "fleet_CloseOperation", response = Empty)]
record CloseFleetOperationAction {
    fleet_operation_id: FleetOperationId,
}

/// Cancel a fleet operation and its unfinished targets.
#[request(name = "fleet_CancelOperation", response = Empty)]
record CancelFleetOperationAction {
    fleet_operation_id: FleetOperationId,
}

/// List the targets of a fleet operation, by stage.
#[request(
    name = "fleet_QueryOperationTargets",
    response = QueryFleetOperationTargetsOutput
)]
record QueryFleetOperationTargetsAction {
    fleet_operation_id: FleetOperationId,
    /// Only targets with this status.
    status?: DeviceOperationStatus,
    /// Page to return. Without this field, the first page is returned.
    page?: PageRequest,
}

/// Output of listing the targets of a fleet operation.
record QueryFleetOperationTargetsOutput {
    /// Targets on this page, by stage.
    targets: [FleetOperationTarget],
    /// Continuation of the traversal.
    page: PageInfo,
}

/// List the devices for which a fleet operation's target selector produced an
/// error.
#[request(
    name = "fleet_QueryOperationSelectionErrors",
    response = QueryFleetOperationSelectionErrorsOutput
)]
record QueryFleetOperationSelectionErrorsAction {
    fleet_operation_id: FleetOperationId,
}

/// Output of listing a fleet operation's selection errors.
record QueryFleetOperationSelectionErrorsOutput {
    errors: [FleetOperationSelectionError],
}
